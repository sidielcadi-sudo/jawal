# ─────────────────────────────────────────────────────────────────────────
# Jawal — variables de production (VPS, sans nom de domaine).
#
# Copier en .env.prod À LA RACINE du dépôt sur le VPS, puis remplir.
# Ce fichier contient des secrets : il n'est jamais versionné (cf. .gitignore)
# et doit rester en 600 (lecture par son seul propriétaire).
#
# Générer chaque secret :  openssl rand -base64 32   (ou -hex 32)
# ─────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────
# Sans domaine : l'IP publique du VPS. À changer le jour où un domaine existe
# (AUTH_URL en découle : une URL fausse casse la connexion).
APP_URL=http://203.0.113.10
APP_NAME=LeadSchool
# Sous-domaines par établissement : vide tant qu'il n'y a pas de domaine.
ROOT_DOMAIN=

# Signature des sessions NextAuth. Le changer déconnecte tout le monde.
AUTH_SECRET=
# Jeton des tâches planifiées (en-tête X-Cron-Secret). À défaut, AUTH_SECRET.
CRON_SECRET=

# ─── Base de données ──────────────────────────────────────────────────────
POSTGRES_USER=jawal
POSTGRES_PASSWORD=
POSTGRES_DB=jawal
# Mot de passe du rôle applicatif (RLS active), posé par scripts/deploy.sh.
APP_DB_PASSWORD=

# ─── Stockage objet (Garage) ──────────────────────────────────────────────
# Secrets du nœud : openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Clé S3 de l'application. Format libre côté Garage ; garder le préfixe GK
# pour rester lisible. Le bucket est créé au premier démarrage.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=jawal-prod
S3_REGION=garage

# ─── E-mail ───────────────────────────────────────────────────────────────
# NOTIFY_DRIVER=log → les envois sont seulement journalisés (aucun mail ne
# part). Passer à `smtp` quand un relais est en place.
NOTIFY_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="LeadSchool <no-reply@exemple.ma>"

# ─── Paiement en ligne (CMI) ──────────────────────────────────────────────
# Laisser vide tant que le contrat commerçant n'est pas actif : le bouton
# « Payer en ligne » reste alors masqué.
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate

# ─── SMS / WhatsApp (optionnel) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
