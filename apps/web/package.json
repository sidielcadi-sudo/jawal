{
  "name": "@jawal/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-guard.mjs && next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@jawal/db": "workspace:*",
    "@jawal/shared": "workspace:*",
    "@jawal/ui": "workspace:*",
    "bcryptjs": "^2.4.3",
    "minio": "^8.0.7",
    "next": "^15.0.3",
    "next-auth": "5.0.0-beta.25",
    "next-intl": "^3.25.1",
    "nodemailer": "^6.9.16",
    "playwright": "^1.60.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jawal/config": "workspace:*",
    "@playwright/test": "^1.49.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-rtl": "^0.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
