{
  "expo": {
    "name": "LeadSchool",
    "slug": "jawal-parents",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "jawalparents",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ma.jawal.parents",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ma.jawal.parents"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
