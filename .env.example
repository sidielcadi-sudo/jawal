# ─── Application ──────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Jawal

# ─── Base de données ──────────────────────────────────────
# Postgres lancé via `pnpm infra:up`
DATABASE_URL="postgresql://jawal:jawal@localhost:5433/jawal?schema=public"

# Connexion "app" (utilisateur applicatif avec RLS active)
DATABASE_URL_APP="postgresql://jawal_app:jawal_app@localhost:5433/jawal?schema=public"

# ─── Redis (cache, queues, sessions) ──────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (NextAuth/Auth.js) ──────────────────────────────
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
# Pas d'AUTH_URL : next-auth s'en servirait pour remplacer l'origine de la
# requête dans le middleware. Accéder au site par 127.0.0.1 au lieu de
# localhost suffisait alors à déclencher une boucle de proxy (500).
AUTH_TRUST_HOST=true

# ─── Stockage S3-compatible (Garage en local) ──────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=garage
S3_ACCESS_KEY=GK2787f17cb62e5bad2e6444fd
S3_SECRET_KEY=92beb34feaa387b49684e0cd52e8c701ade89ca8db66a38ab9cddda91dd702b1
S3_BUCKET=jawal-dev

# ─── Email (Mailpit en local — UI sur http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Jawal <no-reply@jawal.local>"

# ─── Paiement ─────────────────────────────────────────────
# CMI (Maroc) — à renseigner avec les credentials commerçant
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ─── Multi-tenant ─────────────────────────────────────────
# Domaine racine pour les sous-domaines tenants
ROOT_DOMAIN=jawal.local
