/// Programme pédagogique : pour un niveau donné, la liste des matières
/// enseignées avec leur volume horaire hebdomadaire et leur coefficient.
/// Source de vérité pour le calcul des moyennes pondérées et la planification
/// des heures profs (TeacherAssignment).
model CurriculumSubject {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  levelId     String   @map("level_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  weeklyHours Float    @map("weekly_hours")
  coefficient Float    @default(1.0)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([levelId, subjectId])
  @@index([tenantId, levelId])
  @@index([tenantId, subjectId])
  @@map("curriculum_subjects")
}

model Class {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  levelId        String    @map("level_id") @db.Uuid
  /// Filière de la classe (lycée). Null hors lycée.
  trackId        String?   @map("track_id") @db.Uuid
  name           String // "1AC-A", "TD-Info-1"
  /// Libellé arabe de la classe (import MASSAR, documents et bulletins en AR).
  nameAr         String?   @map("name_ar")
  capacity       Int       @default(30)
  mainTeacherId  String?   @map("main_teacher_id") @db.Uuid
  /// Délégué de classe (élève), choisi par la Vie scolaire.
  delegateId     String?   @map("delegate_id") @db.Uuid
  /// Métadonnées de la classe, dont contraintes EDT (E2).
  /// Structure : { "timetableConstraints": ClassTimetableConstraints }
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear           AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level                  Level                  @relation(fields: [levelId], references: [id])
  track                  Track?                 @relation(fields: [trackId], references: [id])
  mainTeacher            Person?                @relation("MainTeacher", fields: [mainTeacherId], references: [id])
  delegate               Person?                @relation("ClassDelegate", fields: [delegateId], references: [id])
  students               StudentClass[]
  attendanceSessions     AttendanceSession[]
  evaluations            Evaluation[]
  teacherAssignments     TeacherAssignment[]
  enrollments            Enrollment[]
  timetableEntries       TimetableEntry[]
  lessonEntries          LessonEntry[]
  teacherPriorityClasses TeacherPriorityClass[]
  groups                 ClassGroup[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId, levelId])
  @@map("classes")
}

/// Groupe d'une classe pour une matière donnée : le dédoublement.
///
/// Certaines séances se font en demi-classe — langues, TP de physique ou de
/// SVT. L'élève garde UNE seule classe (appel, bulletin, effectifs) ; le
/// groupe n'existe que pour la matière concernée, et seulement à l'emploi du
/// temps.
///
/// `subjectId` null = groupe polyvalent (une répartition « groupe A / groupe B »
/// réutilisée par plusieurs matières). Renseigné, le groupe ne vaut que pour
/// cette matière — c'est le cas courant : les groupes de français et ceux de
/// physique ne contiennent pas les mêmes élèves.
model ClassGroup {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  /// Matière à laquelle le groupe s'applique. Null = toutes.
  subjectId String?  @map("subject_id") @db.Uuid
  name      String // "Groupe 1", "Gr. A"
  nameAr    String?  @map("name_ar")
  order     Int      @default(0)
  /// Nombre d'heures hebdomadaires réellement dédoublées, sur le volume de la
  /// matière. Null = toutes les heures.
  ///
  /// Un dédoublement n'est pas toujours permanent : sur 3 h de français, une
  /// seule peut se faire en demi-groupes. Sans cette information, la demande
  /// horaire multiplierait tout le volume par le nombre de groupes et
  /// surestimerait la charge.
  ///
  /// La valeur appartient au couple (classe, matière), pas au groupe : tous les
  /// groupes d'une même matière portent donc la même. L'écran est le seul
  /// chemin d'écriture et les met à jour ensemble ; le calcul retient le
  /// maximum, pour rester juste si une divergence apparaissait malgré tout.
  splitHours Int?    @map("split_hours")
  /// Enseignant du groupe.
  ///
  /// Un dédoublement se tient en parallèle : ses groupes ont donc besoin de
  /// professeurs DIFFÉRENTS. Sans cette colonne, les deux moitiés retombaient
  /// sur l'enseignant de la matière, et le solveur ne pouvait rien placer — un
  /// professeur ne peut pas être à deux endroits à la fois.
  ///
  /// Null = on reprend l'enseignant de l'affectation de la matière.
  teacherId  String?  @map("teacher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject?           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Person?            @relation("ClassGroupTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  members            ClassGroupMember[]
  entries            TimetableEntry[]
  attendanceSessions AttendanceSession[]

  @@unique([classId, subjectId, name])
  @@index([tenantId, classId])
  @@map("class_groups")
}

/// Appartenance d'un élève à un groupe.
///
/// Un élève ne peut être que dans UN groupe par (classe × matière) : deux
/// demi-groupes de français simultanés ne peuvent pas le contenir tous les
/// deux. La contrainte ne s'exprime pas en SQL — elle porte sur le `subjectId`
/// du groupe, pas sur la ligne — et se vérifie donc côté serveur.
model ClassGroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group   ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Person     @relation("StudentClassGroups", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([tenantId, studentId])
  @@map("class_group_members")
}

model StudentClass {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  classId      String    @map("class_id") @db.Uuid
  enrolledAt   DateTime  @default(now()) @map("enrolled_at")
  unenrolledAt DateTime? @map("unenrolled_at")

  student Person @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([tenantId, classId])
  @@map("student_classes")
}

/// Salle : ressource physique de l'établissement, caractérisée par son type et
/// sa capacité — pas par le cycle qui l'occupe.
///
/// Aucun rattachement exclusif à un cycle, volontairement. Une salle
/// d'informatique sert au collège et au lycée ; un gymnase sert à tout le
/// monde ; et pendant les examens régionaux ou nationaux, les salles du
/// collège accueillent les candidats du lycée. Réserver une salle à un cycle
/// interdirait ces usages et laisserait des locaux vides.
///
/// `primaryCycleId` exprime une **priorité**, pas un verrou : le moteur de
/// planification cherche d'abord une salle prioritaire pour le cycle de la
/// classe, puis se rabat sur les salles générales. Un établissement peut ainsi
/// réserver de fait un bâtiment au primaire sans bloquer les cas d'exception.
model Room {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  code           String // "A101", "Labo-Info-2"
  label          String
  /// Libellé arabe de la salle (ex. « مختبر العلوم »).
  labelAr        String?  @map("label_ar")
  capacity       Int      @default(0)
  equipment      String[] @default([])
  /// Cycle prioritaire sur cette salle. Null = salle générale, sans préférence.
  primaryCycleId String?  @map("primary_cycle_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  primaryCycle        Cycle?              @relation(fields: [primaryCycleId], references: [id], onDelete: SetNull)
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetableEntries    TimetableEntry[]
  substitutionsAsRoom TimetableOverride[] @relation("SubstituteRoom")
  examAllocations     ExamRoomAllocation[]

  @@unique([tenantId, code])
  @@index([tenantId, primaryCycleId])
  @@map("rooms")
}

// ─── Audit & fichiers ──────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String // "create", "update", "delete", "login", ...
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model FileObject {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ownerType String   @map("owner_type") // "person.contract", "bulletin", ...
  ownerId   String   @map("owner_id")
  s3Key     String   @unique @map("s3_key")
  filename  String
  mime      String
  sizeBytes Int      @map("size_bytes")
  checksum  String?
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractOf    Person?             @relation("ContractFile")
  photoOf       Person?             @relation("PhotoFile")
  enrollmentDoc EnrollmentDocument? @relation("EnrollmentDocFile")

  @@index([tenantId, ownerType, ownerId])
  @@map("files")
}

// ─── Présences (M05) ───────────────────────────────────────

/// Une session d'appel pour une classe à une date donnée, éventuellement
/// ventilée par période (créneau horaire ou matière). Unique par triplet
/// (classId, date, periodLabel) — `null` autorisé sur periodLabel pour les
/// appels journaliers globaux (primaire par ex).
model AttendanceSession {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  classId     String    @map("class_id") @db.Uuid
  /// Groupe appelé. Null = la classe entière.
  ///
  /// Deux demi-groupes se tiennent au même créneau : sans cette colonne, leurs
  /// deux feuilles d'appel se disputeraient la même clé (classe, date, période)
  /// et le second appel écraserait le premier.
  groupId     String?   @map("group_id") @db.Uuid
  date        DateTime  @db.Date
  periodLabel String?   @map("period_label") // "08h00-09h00", "Cours 1", "Matin", ...
  finalizedAt DateTime? @map("finalized_at") // null = brouillon, set = validé
  /// Verrou Vie Scolaire : posé à la confirmation d'un événement. Empêche le prof
  /// de rouvrir l'appel.
  vsLocked    Boolean   @default(false) @map("vs_locked")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class         Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  group         ClassGroup?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  records       AttendanceRecord[]
  carnetEntries CarnetEntry[]
  events        AttendanceEvent[]

  // Unicité par DEUX index partiels (cf. prisma/rls.sql) — voir la note sur
  // timetable_entries : NULL ne s'oppose pas à NULL en SQL.
  @@index([classId, date, periodLabel])
  @@index([tenantId, date])
  @@map("attendance_sessions")
}

/// Statut d'un élève pour une session d'appel donnée. Default PRESENT —
/// au démarrage d'une nouvelle session, on insère une ligne par élève
/// inscrit (status PRESENT), et l'enseignant ne saisit que les exceptions.
model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  status       AttendanceStatus @default(PRESENT)
  lateMinutes  Int?             @map("late_minutes") // utilisé si status=LATE
  /// Motif paramétrable (surtout pour LATE) — null = « non encore connu ».
  lateReasonId String?          @map("late_reason_id") @db.Uuid
  /// Marqueurs « vie scolaire » cumulables avec n'importe quel statut de présence.
  infirmary    Boolean          @default(false) // passage à l'infirmerie
  punishment   Boolean          @default(false) // punition
  exclusion    Boolean          @default(false) // exclusion de cours
  note         String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session       AttendanceSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student       Person                @relation("StudentAttendance", fields: [studentId], references: [id])
  lateReason    AttendanceReason?     @relation(fields: [lateReasonId], references: [id], onDelete: SetNull)
  justification AbsenceJustification?
  event         AttendanceEvent?

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId])
  @@map("attendance_records")
}

/// Couche ADMINISTRATIVE (Vie Scolaire) — événement de présence à traiter,
/// distinct du cahier d'appel du prof (qui n'est jamais modifié). Généré à la
/// validation de l'appel pour chaque absence/retard/exclusion. La VS confirme,
/// justifie, annule ou convertit l'événement ; la confirmation matérialise une
/// entrée de carnet (couche communication) et verrouille la session.
model AttendanceEvent {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  /// Lien 1-1 vers le record source (jamais modifié).
  attendanceRecordId String                  @unique @map("attendance_record_id") @db.Uuid
  studentId          String                  @map("student_id") @db.Uuid
  classId            String                  @map("class_id") @db.Uuid
  sessionId          String                  @map("session_id") @db.Uuid
  date               DateTime                @db.Date
  /// Catégorie signalée par le prof (snapshot, lecture seule).
  signaledCategory   AttendanceEventCategory @map("signaled_category")
  /// Catégorie officielle après traitement VS (modifiable : convert absence↔retard).
  category           AttendanceEventCategory
  lateMinutes        Int?                    @map("late_minutes")
  status             AttendanceEventStatus   @default(PENDING)
  justifReason       String?                 @map("justif_reason")
  reviewNote         String?                 @map("review_note")
  processedByUserId  String?                 @map("processed_by_user_id") @db.Uuid
  processedAt        DateTime?               @map("processed_at")
  /// Entrée carnet matérialisée à la confirmation (couche communication).
  carnetEntryId      String?                 @map("carnet_entry_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord  @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  student          Person            @relation("StudentAttendanceEvents", fields: [studentId], references: [id], onDelete: Cascade)
  session          AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, date])
  @@map("attendance_events")
}

/// Motif d'appel paramétrable (retard, absence…) géré par l'établissement.
/// Affiché dans la modale de sélection côté enseignant (barre de couleur).
model AttendanceReason {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  label            String
  /// Token de couleur (ex. « cyan », « rose », « amber ») pour la barre latérale.
  color            String?
  order            Int      @default(0)
  active           Boolean  @default(true)
  /// Motif proposé aux parents pour justifier une absence/retard (popup carnet).
  forJustification Boolean  @default(false) @map("for_justification")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@index([tenantId])
  @@map("attendance_reasons")
}

/// Pointage journalier d'un membre du personnel (TEACHER ou STAFF).
/// Une seule ligne par (personId, date). deductionAmount est calculé au
/// moment de l'enregistrement à partir du salaire brut et du status, mais
/// reste stocké pour permettre des ajustements manuels (cas de force
/// majeure, conventions internes, etc.).
/// Famille d'un motif d'absence du personnel. Sert aux regroupements
/// statistiques ; le libellé, lui, reste paramétrable par l'établissement.
enum StaffAbsenceKind {
  SICK_LEAVE
  TRAINING
  PARENTAL
  OFFICIAL_DUTY
  UNJUSTIFIED
  OTHER
}

/// Motif d'absence du personnel, paramétrable par établissement.
model StaffAbsenceReason {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  label     String
  labelAr   String?          @map("label_ar")
  kind      StaffAbsenceKind @default(OTHER)
  /// Token de couleur pour les graphiques (donut, histogrammes).
  color     String?
  order     Int              @default(0)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records StaffAttendance[]

  @@index([tenantId])
  @@map("staff_absence_reasons")
}

model StaffAttendance {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  personId         String                @map("person_id") @db.Uuid
  date             DateTime              @db.Date
  status           StaffAttendanceStatus @default(PRESENT)
  checkIn          DateTime?             @map("check_in")
  checkOut         DateTime?             @map("check_out")
  lateMinutes      Int?                  @map("late_minutes")
  /// Motif de l'absence (null = non renseigné). Ne concerne que les statuts
  /// non présents ; on ne le force pas, pour ne pas bloquer un pointage rapide.
  absenceReasonId  String?               @map("absence_reason_id") @db.Uuid
  /// Montant de la retenue salariale automatique (devise du tenant).
  /// 0 si PRESENT/EXCUSED/LEAVE. Calculé via computeStaffDeduction().
  deductionAmount  Decimal               @default(0) @map("deduction_amount") @db.Decimal(12, 2)
  /// Vrai si l'opérateur a verrouillé la valeur calculée pour ce jour.
  /// Permet de saisir un montant manuel sans qu'un recalcul ne l'écrase.
  deductionLocked  Boolean               @default(false) @map("deduction_locked")
  note             String?
  recordedByUserId String?               @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person        Person              @relation("StaffAttendance", fields: [personId], references: [id], onDelete: Cascade)
  absenceReason StaffAbsenceReason? @relation(fields: [absenceReasonId], references: [id], onDelete: SetNull)

  @@unique([personId, date])
  @@index([tenantId, date])
  @@index([tenantId, personId])
  @@map("staff_attendance")
}

/// Justification d'absence ou de retard. Workflow PENDING → APPROVED/REJECTED.
/// Une seule justification active par AttendanceRecord (1-1).
model AbsenceJustification {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  attendanceRecordId String              @unique @map("attendance_record_id") @db.Uuid
  reason             String
  submittedByUserId  String?             @map("submitted_by_user_id") @db.Uuid
  submittedAt        DateTime            @default(now()) @map("submitted_at")
  status             JustificationStatus @default(PENDING)
  reviewedByUserId   String?             @map("reviewed_by_user_id") @db.Uuid
  reviewedAt         DateTime?           @map("reviewed_at")
  reviewNote         String?             @map("review_note")
  attachmentUrl      String?             @map("attachment_url")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("absence_justifications")
}

// ─── Notes / Évaluations (M06) ─────────────────────────────

/// Matière enseignée (mathématiques, français, arabe, ...).
/// Le coefficient global de la matière s'applique lors du calcul de la
/// moyenne générale d'une période ; on garde la possibilité de coefficients
/// par filière pour la V1 via des configs séparées plus tard.
model Subject {
  competencyNodes CompetencyNode[]
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String // "math", "fr", "ar"
  label       String
  /// Libellé arabe de la matière (ex. « الرياضيات »).
  labelAr     String?  @map("label_ar")
  scale       Float    @default(20) // /20 par défaut (peut être 10, 100, etc.)
  coefficient Float    @default(1.0)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluations            Evaluation[]
  teacherAssignments     TeacherAssignment[]
  curriculumEntries      CurriculumSubject[]
  teacherSpecialties     TeacherSpecialty[]
  timetableEntries       TimetableEntry[]
  substitutionsAsSubject TimetableOverride[] @relation("SubstituteSubject")
  classGroups            ClassGroup[]
  books                  Book[]
  trackCoefficients      TrackSubjectCoefficient[]
  examPapers             ExamPaper[]
  examBlueprints         ExamBlueprint[]

  @@unique([tenantId, code])
  /// Empêche deux matières d'avoir le même libellé dans un même tenant —
  /// évite les "Mathématiques" en double qui rendaient les dropdowns ambigus.
  @@unique([tenantId, label])
  @@map("subjects")
}

/// Une évaluation d'une classe pour une matière à une date donnée.
/// Un Grade y est attaché par élève inscrit dans la classe.
model Evaluation {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  classId      String                 @map("class_id") @db.Uuid
  subjectId    String                 @map("subject_id") @db.Uuid
  periodId     String                 @map("period_id") @db.Uuid
  label        String // "Contrôle 1", "Examen mi-trimestre"
  date         DateTime               @db.Date
  weight       Float                  @default(1.0) // pondération de cette évaluation au sein de la matière
  maxValue     Float                  @default(20.0) @map("max_value")
  /// Devoir facultatif : ne pénalise jamais la moyenne.
  optional     Boolean                @default(false)
  /// Mode du devoir facultatif (ignoré si optional=false).
  /// BONUS : les points au-dessus de 10/20 s'ajoutent à la moyenne.
  /// NOTE  : la note n'est comptée que si elle améliore la moyenne.
  optionalMode EvaluationOptionalMode @default(BONUS) @map("optional_mode")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period  Period  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  grades  Grade[]

  @@index([tenantId, classId, periodId, subjectId])
  @@map("evaluations")
}

/// Note d'un élève à une évaluation. value=null signifie "non noté" ou
/// "absent à l'épreuve" (distingué via la présence d'un AttendanceRecord
/// ce jour-là si besoin — phase 2).
model Grade {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  evaluationId    String   @map("evaluation_id") @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  value           Float?
  comment         String?
  enteredByUserId String?  @map("entered_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  student    Person     @relation("StudentGrades", fields: [studentId], references: [id])

  @@unique([evaluationId, studentId])
  @@index([tenantId, studentId])
  @@map("grades")
}

/// Appréciation d'un élève pour une matière sur une période donnée.
/// Une seule appréciation par triplet (student, subject, period).
model SubjectAppreciation {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  studentId        String   @map("student_id") @db.Uuid
  subjectId        String   @map("subject_id") @db.Uuid
  periodId         String   @map("period_id") @db.Uuid
  text             String
  authoredByUserId String?  @map("authored_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Person @relation("StudentSubjectAppreciations", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, periodId])
  @@index([tenantId, periodId])
  @@map("subject_appreciations")
}

/// Type d'entrée du carnet de correspondance.
enum CarnetEntryType {
  OBSERVATION // remarque pédagogique (enseignant)
  ENCOURAGEMENT
  FELICITATION
  REMARQUE_DISCIPLINAIRE // vie scolaire
  DEFAUT_CARNET
  AVERTISSEMENT
  MESSAGE_DIRECTION
  CONVOCATION // demande d'entretien
  // Entrées officielles matérialisées par la Vie Scolaire (module absences).
  ABSENCE
  RETARD
  EXCLUSION
}

/// Entrée manuelle du carnet de correspondance d'un élève (observation,
/// encouragement, remarque disciplinaire, défaut…). Les événements automatiques
/// (absences/retards/exclusions) ne sont PAS stockés ici : ils sont dérivés à
/// l'affichage depuis les AttendanceRecord finalisés (source unique de vérité).
model CarnetEntry {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  studentId           String          @map("student_id") @db.Uuid
  type                CarnetEntryType
  content             String
  classId             String?         @map("class_id") @db.Uuid
  subjectId           String?         @map("subject_id") @db.Uuid
  /// Lien optionnel vers la séance d'appel d'origine (obs./encour. saisis dans
  /// la feuille d'appel). Permet l'upsert idempotent par (séance, élève, type).
  attendanceSessionId String?         @map("attendance_session_id") @db.Uuid
  occurredAt          DateTime        @default(now()) @map("occurred_at")
  authorUserId        String?         @map("author_user_id") @db.Uuid
  /// Snapshot lisible de l'auteur (ex. « Mme BROWN J. »).
  authorName          String          @map("author_name")
  /// Snapshot du rôle : 'teacher' | 'vie-scolaire' | 'direction'.
  authorRole          String          @map("author_role")
  /// Visibilité parents/élève (utilisé par l'incrément portail parent).
  visibleToParents    Boolean         @default(true) @map("visible_to_parents")
  /// Première consultation par un parent (« Vu le »). Null = non lu.
  parentReadAt        DateTime?       @map("parent_read_at")
  /// Observation/encouragement saisi à l'appel sur un élève absent/en retard :
  /// retenu jusqu'au traitement Vie scolaire (visibleToParents passe à true à ce
  /// moment). Les observations hors absence/retard ne sont jamais retenues.
  heldForReview       Boolean         @default(false) @map("held_for_review")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Person             @relation("StudentCarnet", fields: [studentId], references: [id], onDelete: Cascade)
  attendanceSession AttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId])
  @@index([attendanceSessionId])
  @@map("carnet_entries")
}

/// Journal des relances « appel non fait » envoyées au prof (anti-spam).
/// 1 relance max par séance d'EDT et par jour.
model AppelReminder {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  entryId  String   @map("entry_id") @db.Uuid
  date     DateTime @db.Date
  sentAt   DateTime @default(now()) @map("sent_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([entryId, date])
  @@index([tenantId, date])
  @@map("appel_reminders")
}

/// Décision du conseil de classe pour un élève sur une période.
/// Inclut l'appréciation générale et la décision (passage/redoublement/…).
/// 1 seule entrée par (student, class, period).
model CouncilEntry {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  classId             String           @map("class_id") @db.Uuid
  periodId            String           @map("period_id") @db.Uuid
  studentId           String           @map("student_id") @db.Uuid
  generalAppreciation String?          @map("general_appreciation")
  decision            CouncilDecision?
  heldAt              DateTime?        @map("held_at")
  authoredByUserId    String?          @map("authored_by_user_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Person @relation("StudentCouncil", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, periodId, studentId])
  @@index([tenantId, periodId])
  @@map("council_entries")
}

// ─── Inscriptions (M11) ────────────────────────────────────

/// Dossier d'inscription pour une année scolaire. Unique par
/// (studentId, academicYearId) : un élève ne peut pas avoir 2 dossiers
/// pour la même année. La transition DRAFT → ACTIVE génère le lien
/// StudentClass + les Installments depuis la grille FeeScheduleItem,
/// en appliquant la réduction fratrie si applicable.
model Enrollment {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  studentId         String           @map("student_id") @db.Uuid
  academicYearId    String           @map("academic_year_id") @db.Uuid
  levelId           String           @map("level_id") @db.Uuid
  /// Filière choisie (lycée). Fait autorité pour l'élève : la classe doit
  /// être de la même filière. Null hors lycée.
  trackId           String?          @map("track_id") @db.Uuid
  classId           String?          @map("class_id") @db.Uuid
  status            EnrollmentStatus @default(DRAFT)
  /// Rang fratrie au moment de la validation (1 = aîné).
  /// Sert à appliquer la réduction `siblingDiscountPct` du tenant.
  siblingRank       Int?             @map("sibling_rank")
  /// Réduction effectivement appliquée en pourcentage (issue du tenant
  /// settings ou écrasée manuellement par l'agent).
  discountPct       Decimal?         @map("discount_pct") @db.Decimal(5, 2)
  discountReason    String?          @map("discount_reason")
  /// True une fois les Installments générés. Permet d'éviter une double
  /// génération si on repasse par validate().
  feesGenerated     Boolean          @default(false) @map("fees_generated")
  enrolledAt        DateTime         @default(now()) @map("enrolled_at")
  validatedAt       DateTime?        @map("validated_at")
  withdrawnAt       DateTime?        @map("withdrawn_at")
  withdrawalReason  String?          @map("withdrawal_reason")
  /// Dossier archivé (« Historique ») suite à une radiation finalisée :
  /// consultable mais non modifiable.
  archivedAt        DateTime?        @map("archived_at")
  notes             String?
  createdByUserId   String?          @map("created_by_user_id") @db.Uuid
  validatedByUserId String?          @map("validated_by_user_id") @db.Uuid
  /// Décision d'admission (ACCEPTE / REFUSE).
  refusalReason     String?          @map("refusal_reason")
  decidedAt         DateTime?        @map("decided_at")
  decidedByUserId   String?          @map("decided_by_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Person               @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level             Level                @relation(fields: [levelId], references: [id], onDelete: Cascade)
  track             Track?               @relation(fields: [trackId], references: [id])
  class             Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  documents         EnrollmentDocument[]
  radiationRequests RadiationRequest[]

  @@unique([studentId, academicYearId])
  @@index([tenantId, academicYearId, status])
  @@index([tenantId, classId])
  @@map("enrollments")
}

/// Quota de places par niveau × année (politique d'admission).
model AdmissionQuota {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  levelId        String   @map("level_id") @db.Uuid
  capacity       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level        Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, levelId])
  @@index([tenantId, academicYearId])
  @@map("admission_quotas")
}

/// Pièce justificative requise (checklist configurable). levelId null = tous niveaux.
model RequiredDocument {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  labelFr   String   @map("label_fr")
  labelAr   String   @map("label_ar")
  levelId   String?  @map("level_id") @db.Uuid
  required  Boolean  @default(true)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level     Level?               @relation(fields: [levelId], references: [id], onDelete: Cascade)
  documents EnrollmentDocument[]

  @@unique([tenantId, code])
  @@index([tenantId, levelId])
  @@map("required_documents")
}

/// Pièce déposée pour un dossier d'inscription (FileObject dans MinIO).
model EnrollmentDocument {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  enrollmentId       String         @map("enrollment_id") @db.Uuid
  requiredDocumentId String?        @map("required_document_id") @db.Uuid
  fileId             String?        @unique @map("file_id") @db.Uuid
  status             DocumentStatus @default(PENDING)
  note               String?
  validatedAt        DateTime?      @map("validated_at")
  validatedByUserId  String?        @map("validated_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  required   RequiredDocument? @relation(fields: [requiredDocumentId], references: [id], onDelete: SetNull)
  file       FileObject?       @relation("EnrollmentDocFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@index([tenantId, enrollmentId])
  @@map("enrollment_documents")
}

// ─── Emploi du temps (M12) ─────────────────────────────────

/// Créneau horaire de la grille de l'établissement (semaine type). Réutilisé
/// par toutes les classes : ex 08h00-09h00, 09h00-10h00, … et créneaux pause
/// (récré, cantine). Unique par (tenant × startTime × endTime).
model TimetableSlot {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Heure de début au format HH:MM (24h)
  startTime String   @map("start_time")
  /// Heure de fin au format HH:MM (24h)
  endTime   String   @map("end_time")
  /// Libellé optionnel (« Récréation », « Pause déjeuner »…). Si null,
  /// l'UI affiche juste l'intervalle horaire.
  label     String?
  /// True si pas de cours saisissable (pause/récré). Aucune TimetableEntry
  /// ne devrait pointer vers ce slot.
  isBreak   Boolean  @default(false) @map("is_break")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([tenantId, startTime, endTime])
  @@index([tenantId, order])
  @@map("timetable_slots")
}

/// Une case de l'emploi du temps : pour une (classe × jour × créneau) sur
/// une année scolaire, on a (matière × prof × salle). Unique sur
/// (classId × academicYearId × dayOfWeek × slotId).
///
/// Les conflits prof (même prof dans 2 classes au même créneau) et
/// salle (même salle dans 2 classes au même créneau) sont détectés au
/// vol côté serveur — pas de contrainte SQL pour permettre le rattrapage
/// (l'admin peut vouloir saisir un conflit puis le résoudre).
model TimetableEntry {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  classId        String    @map("class_id") @db.Uuid
  slotId         String    @map("slot_id") @db.Uuid
  dayOfWeek      DayOfWeek @map("day_of_week")
  subjectId      String?   @map("subject_id") @db.Uuid
  /// Groupe concerné par la séance. Null = la classe entière.
  ///
  /// Deux séances simultanées sur la même case sont donc possibles dès qu'elles
  /// visent des groupes différents : c'est tout l'objet du dédoublement.
  groupId        String?   @map("group_id") @db.Uuid
  teacherId      String?   @map("teacher_id") @db.Uuid
  roomId         String?   @map("room_id") @db.Uuid
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class         Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  slot          TimetableSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subject       Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  group         ClassGroup?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher       Person?             @relation("TeacherTimetable", fields: [teacherId], references: [id], onDelete: SetNull)
  room          Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  overrides     TimetableOverride[]
  lessonEntries LessonEntry[]

  // Unicité assurée par DEUX index partiels (cf. prisma/rls.sql) :
  //   - classe entière  : UNIQUE(class, année, jour, créneau) WHERE group_id IS NULL
  //   - par groupe      : UNIQUE(class, année, jour, créneau, group) WHERE group_id IS NOT NULL
  // Un simple @@unique incluant groupId ne suffirait pas : en SQL, NULL n'entre
  // pas en conflit avec NULL, et deux séances « classe entière » passeraient.
  @@index([classId, academicYearId, dayOfWeek, slotId])
  @@index([tenantId, academicYearId, dayOfWeek, slotId])
  @@index([tenantId, teacherId])
  @@index([tenantId, roomId])
  @@map("timetable_entries")
}

/// Exception ponctuelle à une case d'EDT pour une date donnée. Permet
/// d'annuler un cours (jour férié, absence prof) ou de placer un remplaçant
/// (substitute teacher / changement de salle) sans toucher la semaine type.
///
/// Unique sur (entryId × date) : 1 override max par séance.
model TimetableOverride {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  entryId             String                @map("entry_id") @db.Uuid
  date                DateTime              @db.Date
  kind                TimetableOverrideKind
  substituteTeacherId String?               @map("substitute_teacher_id") @db.Uuid
  substituteRoomId    String?               @map("substitute_room_id") @db.Uuid
  substituteSubjectId String?               @map("substitute_subject_id") @db.Uuid
  reason              String?
  /// Validation par la vie scolaire : soumet le remplacement à l'approbation.
  validatedAt         DateTime?             @map("validated_at")
  validatedByUserId   String?               @map("validated_by_user_id") @db.Uuid
  /// Approbation par la direction/admin. Les messages (parent + remplaçant) ne
  /// partent qu'une fois APPROVED.
  approvalStatus      SubstitutionApproval  @default(PENDING) @map("approval_status")
  approvalByUserId    String?               @map("approval_by_user_id") @db.Uuid
  approvalAt          DateTime?             @map("approval_at")
  approvalComment     String?               @map("approval_comment")
  createdByUserId     String?               @map("created_by_user_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry             TimetableEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  substituteTeacher Person?        @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id], onDelete: SetNull)
  substituteRoom    Room?          @relation("SubstituteRoom", fields: [substituteRoomId], references: [id], onDelete: SetNull)
  substituteSubject Subject?       @relation("SubstituteSubject", fields: [substituteSubjectId], references: [id], onDelete: SetNull)

  @@unique([entryId, date])
  @@index([tenantId, date])
  @@map("timetable_overrides")
}

// ─── Cahier de texte ───────────────────────────────────────

/// Cahier de texte d'une séance : le contenu pédagogique saisi par
/// l'enseignant pour une occurrence datée d'une case d'EDT. Une séance =
/// (TimetableEntry × date) → au plus une entrée de cahier (unique).
/// `classId` est dénormalisé depuis l'entry pour filtrer la consultation
/// côté parent. Les infos de séance (matière, salle, créneau, jour) sont
/// lues via la relation `entry`.
model LessonEntry {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  entryId           String    @map("entry_id") @db.Uuid
  classId           String    @map("class_id") @db.Uuid
  date              DateTime  @db.Date
  /// Bloc « Contenu du cours »
  title             String
  summary           String?
  activities        String?
  competencies      String?
  /// Thème / chapitre du cours (saisi sous le contenu).
  theme             String?
  /// Bloc « Visibilité »
  visibleToStudents Boolean   @default(true) @map("visible_to_students")
  visibleToParents  Boolean   @default(true) @map("visible_to_parents")
  /// Visibilité programmée : si renseigné, masqué élèves/parents tant que
  /// `publishAt` n'est pas atteint (ex. cacher un contrôle jusqu'à la fin).
  /// Null = visible immédiatement (sous réserve des drapeaux ci-dessus).
  publishAt         DateTime? @map("publish_at")
  createdById       String?   @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry     TimetableEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  homeworks Homework[]
  resources LessonResource[]

  @@unique([entryId, date])
  @@index([tenantId, classId, date])
  @@map("lesson_entries")
}

/// Ressource pédagogique attachée à une séance : fichier (MinIO via
/// FileObject) ou lien externe. `fileId` référence un FileObject
/// (ownerType="lesson.resource") ; null pour un lien (`url` renseigné).
model LessonResource {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  lessonEntryId String       @map("lesson_entry_id") @db.Uuid
  kind          ResourceKind
  fileId        String?      @map("file_id") @db.Uuid
  url           String?
  label         String
  order         Int          @default(0)
  createdAt     DateTime     @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessonEntry LessonEntry @relation(fields: [lessonEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId, lessonEntryId])
  @@map("lesson_resources")
}

/// Devoir à faire, toujours rattaché à une séance (cahier de texte).
/// Visible élèves + parents selon la visibilité de la séance parente.
model Homework {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  lessonEntryId String              @map("lesson_entry_id") @db.Uuid
  description   String
  dueDate       DateTime?           @map("due_date") @db.Date
  type          HomeworkType        @default(EXERCICE)
  difficulty    HomeworkDifficulty?
  order         Int                 @default(0)
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessonEntry LessonEntry @relation(fields: [lessonEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId, lessonEntryId])
  @@index([tenantId, dueDate])
  @@map("homeworks")
}

/// Contrainte paramétrable qui pilote le solveur d'EDT. Une ligne par
/// (tenant × kind) — activable/désactivable + config JSON par type.
model TimetableConstraint {
  id        String                  @id @default(uuid()) @db.Uuid
  tenantId  String                  @map("tenant_id") @db.Uuid
  kind      TimetableConstraintKind
  enabled   Boolean                 @default(true)
  config    Json                    @default("{}")
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind])
  @@map("timetable_constraints")
}

// ─── Communication (M09) ───────────────────────────────────

/// Annonce établissement, ciblée selon une audience.
/// publishedAt=null → brouillon. classId/levelId requis si audience=CLASS/LEVEL.
model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  authorId    String               @map("author_id") @db.Uuid
  title       String
  body        String
  audience    AnnouncementAudience
  classId     String?              @map("class_id") @db.Uuid
  levelId     String?              @map("level_id") @db.Uuid
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, publishedAt])
  @@map("announcements")
}

// ─── Enquêtes de satisfaction ──────────────────────────────

/// Enquête de satisfaction adressée à une audience (parents, profs…).
/// Les questions RATING_5 alimentent le KPI « satisfaction » du Pilotage.
/// periodId/academicYearId : portée optionnelle pour filtrer le KPI.
model Survey {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  title          String
  description    String?
  audience       SurveyAudience @default(PARENTS)
  status         SurveyStatus   @default(DRAFT)
  /// Réponses anonymes : on ne lie pas la réponse à un répondant identifié.
  anonymous      Boolean        @default(true)
  academicYearId String?        @map("academic_year_id") @db.Uuid
  periodId       String?        @map("period_id") @db.Uuid
  opensAt        DateTime?      @map("opens_at")
  closesAt       DateTime?      @map("closes_at")
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([tenantId, status])
  @@index([tenantId, periodId])
  @@map("surveys")
}

/// Question d'une enquête. RATING_5 = note 1–5 (KPI), TEXT = réponse libre.
model SurveyQuestion {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  surveyId  String             @map("survey_id") @db.Uuid
  label     String
  type      SurveyQuestionType @default(RATING_5)
  order     Int                @default(0)
  required  Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([tenantId, surveyId])
  @@map("survey_questions")
}

/// Une soumission complète à une enquête. `submittedById` (User) est posé
/// pour les répondants identifiés afin d'empêcher les doublons ; null si
/// anonyme non tracé. L'unicité (survey, user) bloque la double réponse.
model SurveyResponse {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  surveyId      String   @map("survey_id") @db.Uuid
  submittedById String?  @map("submitted_by_id") @db.Uuid
  submittedAt   DateTime @default(now()) @map("submitted_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@unique([surveyId, submittedById])
  @@index([tenantId, surveyId])
  @@map("survey_responses")
}

/// Réponse à une question. `rating` (1–5) pour RATING_5, `text` pour TEXT.
model SurveyAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  responseId String   @map("response_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  rating     Int?
  text       String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([tenantId, responseId])
  @@index([tenantId, questionId])
  @@map("survey_answers")
}

/// Conversation 1↔1 ou de groupe entre utilisateurs (parents, enseignants).
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  subject   String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([tenantId, updatedAt])
  @@map("conversations")
}

/// Participant à une conversation. lastReadAt sert au compteur de non-lus.
model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([tenantId, userId])
  @@map("conversation_participants")
}

/// Message dans une conversation.
model Message {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderUserId   String   @map("sender_user_id") @db.Uuid
  body           String
  sentAt         DateTime @default(now()) @map("sent_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

// ─── Soutien scolaire (cours de soutien / activités payantes) ──

enum SupportEnrollmentStatus {
  ACTIVE
  WITHDRAWN
}

/// Mode de tarification d'un cours de soutien.
enum SupportPricingMode {
  FREE // gratuit
  PER_SESSION // prix par séance
  MONTHLY // forfait mensuel
  TERM // forfait trimestriel
  ANNUAL // forfait annuel
}

/// Cours de soutien (activité parascolaire, payante ou gratuite). Le planning
/// hebdomadaire est porté par plusieurs `SupportSlot` (N séances/semaine).
/// Rattaché à une année. Références externes (matière/prof/niveau) en UUID
/// scalaire : isolation par RLS via `tenant_id` (cf. rls.sql).
model SupportCourse {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  academicYearId String             @map("academic_year_id") @db.Uuid
  subjectId      String             @map("subject_id") @db.Uuid
  teacherId      String?            @map("teacher_id") @db.Uuid
  levelId        String?            @map("level_id") @db.Uuid
  title          String
  pricingMode    SupportPricingMode @default(FREE) @map("pricing_mode")
  /// Montant selon le mode (par séance / mensuel / trimestriel / annuel). 0 si gratuit.
  price          Decimal            @default(0) @db.Decimal(12, 2)
  description    String?
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  slots       SupportSlot[]
  enrollments SupportEnrollment[]
  sessions    SupportSession[]
  resources   SupportResource[]

  @@index([tenantId, academicYearId])
  @@map("support_courses")
}

/// Ressource pédagogique d'un cours de soutien (lien PDF / vidéo / fiche).
model SupportResource {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  supportCourseId  String   @map("support_course_id") @db.Uuid
  supportSessionId String?  @map("support_session_id") @db.Uuid
  title            String
  url              String
  createdAt        DateTime @default(now()) @map("created_at")

  course  SupportCourse   @relation(fields: [supportCourseId], references: [id], onDelete: Cascade)
  session SupportSession? @relation(fields: [supportSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, supportCourseId])
  @@index([tenantId, supportSessionId])
  @@map("support_resources")
}

/// Créneau hebdomadaire récurrent d'un cours de soutien (jour/heure/salle).
/// Le nombre de créneaux = nombre de séances par semaine.
model SupportSlot {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  supportCourseId String    @map("support_course_id") @db.Uuid
  dayOfWeek       DayOfWeek @map("day_of_week")
  startTime       String    @map("start_time")
  endTime         String    @map("end_time")
  roomId          String?   @map("room_id") @db.Uuid

  course SupportCourse @relation(fields: [supportCourseId], references: [id], onDelete: Cascade)

  @@index([tenantId, supportCourseId])
  @@map("support_slots")
}

/// Affectation d'un élève à un cours de soutien (volontaire ou recommandé).
model SupportEnrollment {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  supportCourseId String                  @map("support_course_id") @db.Uuid
  studentId       String                  @map("student_id") @db.Uuid
  recommended     Boolean                 @default(false)
  status          SupportEnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime                @default(now()) @map("enrolled_at")
  unenrolledAt    DateTime?               @map("unenrolled_at")

  course SupportCourse @relation(fields: [supportCourseId], references: [id], onDelete: Cascade)

  @@unique([supportCourseId, studentId])
  @@index([tenantId, studentId])
  @@map("support_enrollments")
}

/// Séance datée d'un cours de soutien (contenu + appel + appréciations — P2).
model SupportSession {
  skills SupportSessionSkill[]
  competencyAssessments CompetencyAssessment[]
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  supportCourseId String   @map("support_course_id") @db.Uuid
  date            DateTime @db.Date
  topic           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  course     SupportCourse       @relation(fields: [supportCourseId], references: [id], onDelete: Cascade)
  attendance SupportAttendance[]
  resources  SupportResource[]

  @@unique([supportCourseId, date])
  @@index([tenantId, date])
  @@map("support_sessions")
}

/// Présence + appréciation d'un élève sur une séance de soutien.
model SupportAttendance {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  present      Boolean  @default(true)
  appreciation String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId])
  @@map("support_attendance")
}

// ─── Finance (M10) ─────────────────────────────────────────

/// Grille tarifaire pour un niveau et une année scolaire.
/// Type de frais : annuel (récurrent) ou exceptionnel (ponctuel, facultatif).
enum FeeKind {
  ANNUAL
  EXCEPTIONAL
}

/// Catégorie d'un frais — pilote l'applicabilité conditionnelle à l'inscription.
enum FeeCategory {
  TUITION // scolarité (toujours applicable)
  INSCRIPTION // frais d'inscription (non remboursables par défaut)
  TRANSPORT // transport (si l'élève utilise le transport scolaire)
  CANTEEN // cantine (si demi-pensionnaire ou interne)
  DAYCARE // garderie
  OTHER // autres
}

/// installmentCount = nombre d'échéances mensuelles à générer.
model FeeScheduleItem {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  academicYearId    String      @map("academic_year_id") @db.Uuid
  levelId           String      @map("level_id") @db.Uuid
  label             String // "Frais annuels", "Cantine", etc.
  kind              FeeKind     @default(ANNUAL)
  category          FeeCategory @default(TUITION)
  totalAmount       Decimal     @map("total_amount") @db.Decimal(12, 2)
  installmentCount  Int         @default(9) @map("installment_count")
  /// Si true, le nb d'échéances est figé et non modifiable à l'admission.
  installmentLocked Boolean     @default(false) @map("installment_locked")
  firstDueMonth     Int         @default(9) @map("first_due_month") // 9 = sept
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level         Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  /// Réductions rattachées à ce seul frais (ancien ciblage 1-N, conservé).
  discountRules DiscountRule[]
  /// Réductions portant sur une sélection de frais (ciblage multiple).
  scopedDiscounts DiscountRule[] @relation("DiscountRuleFees")

  @@unique([tenantId, academicYearId, levelId, label])
  @@map("fee_schedules")
}

/// Règle de réduction tarifaire paramétrable (catalogue tenant).
/// Ex. "Fratrie (cadet)" −10 %, "Paiement annuel comptant" −5 %.
/// Rattachée à un frais précis (feeScheduleItemId) ou globale (null).
/// Sélectionnable manuellement à l'acceptation d'un dossier d'inscription.
model DiscountRule {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  label             String
  pct               Decimal  @db.Decimal(5, 2)
  active            Boolean  @default(true)
  order             Int      @default(0)
  feeScheduleItemId String?  @map("fee_schedule_item_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Ciblage historique : un seul frais (ou null = tous). Toujours honoré.
  fee    FeeScheduleItem? @relation(fields: [feeScheduleItemId], references: [id], onDelete: Cascade)
  /// Ciblage multiple : la réduction porte sur cette sélection de frais.
  /// Vide + `feeScheduleItemId` null ⇒ la réduction s'applique à tous les frais.
  fees   FeeScheduleItem[] @relation("DiscountRuleFees")

  @@index([tenantId])
  @@map("discount_rules")
}

/// Échéance due pour un élève. Générée à la volée depuis une FeeScheduleItem.
/// status calculé : sumPayments == 0 → PENDING, < amount → PARTIAL, ≥ → PAID.
model Installment {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  studentId         String            @map("student_id") @db.Uuid
  feeScheduleItemId String?           @map("fee_schedule_item_id") @db.Uuid // null si ad hoc
  /// Rattachement à un cours de soutien (activité « Soutien » dans Finances).
  supportCourseId   String?           @map("support_course_id") @db.Uuid
  label             String // "Mensualité septembre"
  amount            Decimal           @db.Decimal(12, 2)
  dueDate           DateTime          @map("due_date") @db.Date
  status            InstallmentStatus @default(PENDING)
  // Effacement de créance (remise gracieuse) : la créance passe en CANCELLED
  // mais reste tracée (montant effacé, motif, auteur, date) pour le rapport
  // « créances annulées » et l'écriture comptable OD (remise).
  waivedAmount      Decimal?          @map("waived_amount") @db.Decimal(12, 2)
  waivedReason      String?           @map("waived_reason")
  waivedByUserId    String?           @map("waived_by_user_id") @db.Uuid
  waivedAt          DateTime?         @map("waived_at")
  /// Relances de paiement déjà envoyées pour cette échéance (J-3 puis J-1).
  /// Colonnes dédiées plutôt qu'un compteur : le job tourne une fois par jour
  /// et doit rester idempotent s'il est relancé.
  reminder3dSentAt  DateTime?         @map("reminder_3d_sent_at")
  reminder1dSentAt  DateTime?         @map("reminder_1d_sent_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student                  Person                    @relation("StudentInstallments", fields: [studentId], references: [id])
  payments                 Payment[]
  exceptionalFeeAssignment ExceptionalFeeAssignment?

  @@index([tenantId, studentId, status])
  @@index([tenantId, dueDate])
  @@map("installments")
}

/// Paiement enregistré sur une échéance. Plusieurs paiements possibles
/// (paiement partiel). status de l'échéance recalculé après chaque insert.
model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  installmentId    String        @map("installment_id") @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  reference        String? // numéro chèque, ref virement, txn CMI, etc.
  paidAt           DateTime      @default(now()) @map("paid_at")
  recordedByUserId String?       @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@map("payments")
}

/// Jeton de notification push d'un appareil (app mobile parent, Expo Push).
/// `token` = ExponentPushToken[…]. Un user peut avoir plusieurs appareils.
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String? // ios | android
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, userId])
  @@map("device_tokens")
}

/// Statut d'une commande de paiement en ligne (passerelle).
enum OnlinePaymentStatus {
  PENDING // commande créée, en attente du retour passerelle
  PAID // confirmé (callback signé Approved)
  FAILED // refusé / annulé
}

/// Commande de paiement en ligne (passerelle CMI). L'`id` sert d'`oid` CMI et
/// corrèle la transaction aux échéances à solder ; la confirmation arrive via
/// le callback serveur-à-serveur (signature vérifiée) qui enregistre alors les
/// paiements. Aucune relation Prisma (accès par `prismaAdmin` scopé tenant côté
/// callback, sans session) — RLS assurée par la politique tenant_id.
model OnlinePayment {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  studentId       String              @map("student_id") @db.Uuid
  installmentIds  String[]            @map("installment_ids") @db.Uuid
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("MAD")
  provider        String              @default("CMI")
  status          OnlinePaymentStatus @default(PENDING)
  providerRef     String?             @map("provider_ref") // ex. CMI transaction id (oid retour)
  rawResult       Json?               @map("raw_result")
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  paidAt          DateTime?           @map("paid_at")

  @@index([tenantId, status])
  @@map("online_payments")
}

/// Statut d'un frais exceptionnel.
/// DRAFT : créé, pas encore notifié / facturé.
/// PUBLISHED : notifié aux parents, affectations actives.
/// CLOSED : clos (plus de nouvelle acceptation).
enum ExceptionalFeeStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// Consentement parent pour un frais exceptionnel optionnel.
/// Un frais obligatoire force ACCEPTED dès la publication.
enum FeeConsent {
  PENDING
  ACCEPTED
  REFUSED
}

/// Catalogue paramétrable des types de frais exceptionnels par établissement
/// (Sortie scolaire, Voyage, Livres, Atelier, Uniforme, Examen externe, …).
model ExceptionalFeeType {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  labelFr   String   @map("label_fr")
  labelAr   String   @map("label_ar")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fees   ExceptionalFee[]

  @@unique([tenantId, labelFr])
  @@index([tenantId, order])
  @@map("exceptional_fee_types")
}

/// Frais exceptionnel : ponctuel, variable, ciblé (classe / élèves), optionnel
/// ou obligatoire. Distinct des frais annuels (FeeScheduleItem) : ne se mélange
/// jamais aux mensualités. Une fois accepté (ou obligatoire), une ligne
/// Installment est créée pour entrer dans le flux de paiement existant.
model ExceptionalFee {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  academicYearId  String               @map("academic_year_id") @db.Uuid
  typeId          String?              @map("type_id") @db.Uuid
  label           String // "Sortie au Musée de l'Histoire"
  description     String?
  amount          Decimal              @db.Decimal(12, 2)
  activityDate    DateTime?            @map("activity_date") @db.Date
  dueDate         DateTime?            @map("due_date") @db.Date // échéance de paiement de la ligne créée
  mandatory       Boolean              @default(false) // obligatoire → pas de choix parent
  status          ExceptionalFeeStatus @default(DRAFT)
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  type         ExceptionalFeeType?        @relation(fields: [typeId], references: [id], onDelete: SetNull)
  assignments  ExceptionalFeeAssignment[]

  @@index([tenantId, status])
  @@map("exceptional_fees")
}

/// Affectation d'un frais exceptionnel à un élève + consentement parent.
/// installmentId : ligne facturée créée à l'acceptation (ou à la publication
/// si le frais est obligatoire). Null tant que non accepté.
model ExceptionalFeeAssignment {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @map("tenant_id") @db.Uuid
  exceptionalFeeId    String      @map("exceptional_fee_id") @db.Uuid
  studentId           String      @map("student_id") @db.Uuid
  consent             FeeConsent  @default(PENDING)
  consentAt           DateTime?   @map("consent_at")
  consentByUserId     String?     @map("consent_by_user_id") @db.Uuid
  installmentId       String?     @unique @map("installment_id") @db.Uuid
  /// Annulation après paiement : mode de traitement du montant déjà versé.
  refundMode          RefundMode? @map("refund_mode")
  refundedAt          DateTime?   @map("refunded_at")
  /// Justificatif de remboursement (FileObject MinIO).
  refundFileId        String?     @unique @map("refund_file_id") @db.Uuid
  /// Échéance sur laquelle le montant a été imputé (mode CREDITED).
  creditInstallmentId String?     @map("credit_installment_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exceptionalFee ExceptionalFee @relation(fields: [exceptionalFeeId], references: [id], onDelete: Cascade)
  student        Person         @relation("StudentExceptionalFees", fields: [studentId], references: [id], onDelete: Cascade)
  installment    Installment?   @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@unique([exceptionalFeeId, studentId])
  @@index([tenantId, studentId, consent])
  @@map("exceptional_fee_assignments")
}

/// Traitement du montant versé lors de l'annulation d'un frais exceptionnel.
/// REFUNDED : remboursement effectué (sortie de caisse, avec justificatif).
/// CREDITED : montant imputé sur une autre échéance (recalculée).
enum RefundMode {
  REFUNDED
  CREDITED
}

/// Catégorie d'une dépense de l'établissement.
enum ExpenseCategory {
  SALARY // salaires / paie
  RENT // loyer
  UTILITIES // eau / électricité / internet
  SUPPLIES // fournitures / matériel
  MAINTENANCE // entretien / réparations
  TRANSPORT // transport
  TAXES // impôts / taxes
  OTHER
}

/// Dépense de l'établissement (sortie de caisse). Alimente le solde de
/// trésorerie réel : encaissements − dépenses.
model Expense {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  label            String
  category         ExpenseCategory @default(OTHER)
  amount           Decimal         @db.Decimal(12, 2)
  date             DateTime        @db.Date
  method           PaymentMethod?
  note             String?
  recordedByUserId String?         @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("expenses")
}

/// Relance de paiement adressée à la famille d'un élève en impayé.
/// Historique consultable depuis la « Gestion des impayés ».
model PaymentReminder {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  note            String
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Person @relation("StudentPaymentReminders", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@map("payment_reminders")
}

// ─── Transport scolaire (Phase A : référentiel) ────────────────

enum BusStatus {
  EN_SERVICE
  PANNE
  REMPLACEMENT
}

/// Zone tarifaire (Maroc) : proche / moyenne / loin → tarif annuel transport.
/// Le montant annuel alimente le moteur de frais (catégorie TRANSPORT).
model TransportZone {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String // "Zone 1", "Zone 2"…
  order        Int      @default(0)
  annualAmount Decimal  @default(0) @map("annual_amount") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stops             TransportStop[]
  studentTransports StudentTransport[]

  @@index([tenantId])
  @@map("transport_zones")
}

/// Bus de l'établissement.
model Bus {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  number    String // numéro du bus
  plate     String? // matricule (immatriculation)
  capacity  Int       @default(0)
  status    BusStatus @default(EN_SERVICE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  TransportLine[]

  @@index([tenantId])
  @@map("buses")
}

/// Ligne de bus : quartiers, bus, chauffeur, accompagnatrice, horaires, capacité.
model TransportLine {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String // "Ligne Sidi Maarouf"…
  districts        String? // quartiers desservis (texte libre)
  busId            String?  @map("bus_id") @db.Uuid
  driverId         String?  @map("driver_id") @db.Uuid // Person (STAFF)
  attendantId      String?  @map("attendant_id") @db.Uuid // Person (STAFF) — mou3awnate
  morningDeparture String?  @map("morning_departure") // "07:00"
  morningArrival   String?  @map("morning_arrival")
  eveningDeparture String?  @map("evening_departure")
  eveningArrival   String?  @map("evening_arrival")
  capacity         Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant             Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bus                Bus?                         @relation(fields: [busId], references: [id], onDelete: SetNull)
  driver             Person?                      @relation("LineDriver", fields: [driverId], references: [id], onDelete: SetNull)
  attendant          Person?                      @relation("LineAttendant", fields: [attendantId], references: [id], onDelete: SetNull)
  stops              TransportStop[]
  studentTransports  StudentTransport[]
  attendanceSessions TransportAttendanceSession[]

  @@index([tenantId])
  @@map("transport_lines")
}

/// Arrêt d'une ligne : nom, repère, ordre de passage, heure prévue, zone.
model TransportStop {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  lineId      String   @map("line_id") @db.Uuid
  zoneId      String?  @map("zone_id") @db.Uuid
  name        String // "Mosquée Al Qods"…
  address     String? // adresse + repère local
  order       Int      @default(0)
  plannedTime String?  @map("planned_time") // "07:15"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  line              TransportLine      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  zone              TransportZone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  studentTransports StudentTransport[]

  @@index([tenantId, lineId])
  @@map("transport_stops")
}

enum TransportAssignStatus {
  ACTIVE
  SUSPENDED
}

/// Affectation d'un élève au transport : ligne, arrêt, jours, zone (facturation),
/// + règles de sécurité (personnes autorisées, sortie seule). 1 par élève.
model StudentTransport {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  studentId         String                @unique @map("student_id") @db.Uuid
  lineId            String                @map("line_id") @db.Uuid
  stopId            String?               @map("stop_id") @db.Uuid
  zoneId            String?               @map("zone_id") @db.Uuid
  /// Jours de transport (codes MON…SAT).
  days              String[]              @default([])
  pickupTime        String?               @map("pickup_time")
  dropoffTime       String?               @map("dropoff_time")
  /// Sécurité.
  exitAlone         Boolean               @default(false) @map("exit_alone")
  securityNotes     String?               @map("security_notes")
  /// Personnes autorisées à récupérer l'enfant : [{ name, cin }].
  authorizedPickups Json                  @default("[]") @map("authorized_pickups")
  status            TransportAssignStatus @default(ACTIVE)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Person         @relation("StudentTransport", fields: [studentId], references: [id], onDelete: Cascade)
  line    TransportLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stop    TransportStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)
  zone    TransportZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([tenantId, lineId])
  @@map("student_transports")
}

// ─── Transport scolaire (Phase C : appel / présence) ───────────

enum TransportDirection {
  MORNING
  EVENING
}

enum TransportAttendanceStatus {
  PRESENT // matin : présent à l'arrêt
  ABSENT // matin : absent
  LATE // matin : retard
  NOT_PICKED_UP // non récupéré (matin : pas pris le bus ; soir : parent absent)
  BOARDED // soir : monté dans le bus
  DROPPED // soir : déposé à l'arrêt
  INCIDENT // incident (malade, blessure, conflit…)
}

/// Session d'appel d'une ligne pour une date et un sens (matin / soir).
model TransportAttendanceSession {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  lineId    String             @map("line_id") @db.Uuid
  date      DateTime           @db.Date
  direction TransportDirection
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  line    TransportLine               @relation(fields: [lineId], references: [id], onDelete: Cascade)
  records TransportAttendanceRecord[]

  @@unique([lineId, date, direction])
  @@index([tenantId, date])
  @@map("transport_attendance_sessions")
}

/// Pointage d'un élève dans une session d'appel transport (horodaté).
model TransportAttendanceRecord {
  id               String                    @id @default(uuid()) @db.Uuid
  tenantId         String                    @map("tenant_id") @db.Uuid
  sessionId        String                    @map("session_id") @db.Uuid
  studentId        String                    @map("student_id") @db.Uuid
  status           TransportAttendanceStatus
  recordedAt       DateTime                  @default(now()) @map("recorded_at")
  recordedByUserId String?                   @map("recorded_by_user_id") @db.Uuid
  note             String?
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  tenant  Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session TransportAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Person                     @relation("StudentTransportAttendance", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId])
  @@map("transport_attendance_records")
}

// ─── Notifications (abstraction multi-canal + journal) ─────────

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING // en file (fournisseur réel à venir)
  SENT // envoyé (ou journalisé par le driver « log »)
  FAILED
  SKIPPED // pas de destinataire / pas de consentement
}

/// Journal des notifications (un enregistrement par message). Le contenu est
/// rendu au moment de l'envoi ; `template` garde la clé pour analytics.
model NotificationLog {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  channel       NotificationChannel
  recipient     String // numéro WhatsApp / téléphone / e-mail
  recipientName String?             @map("recipient_name")
  studentId     String?             @map("student_id") @db.Uuid
  template      String
  body          String
  status        NotificationStatus  @default(PENDING)
  error         String?
  relatedType   String?             @map("related_type")
  relatedId     String?             @map("related_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  sentAt        DateTime?           @map("sent_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("notification_logs")
}

// ─── RH : congés & absences du personnel (Phase 1) ─────────────

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Type de congé/absence paramétrable (règles marocaines + variations école).
model LeaveType {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  code                  String
  labelFr               String   @map("label_fr")
  labelAr               String   @map("label_ar")
  /// Congé payé (n'impacte pas le salaire) ou sans solde.
  paid                  Boolean  @default(true)
  /// Décompté du solde annuel acquis (ex. congé annuel 1,5 j/mois).
  accrues               Boolean  @default(false)
  /// Acquisition mensuelle (ex. 1.5) — utilisé pour le solde calculé à la volée.
  accrualPerMonth       Float?   @map("accrual_per_month")
  /// Justificatif obligatoire (ex. congé maladie).
  requiresJustification Boolean  @default(false) @map("requires_justification")
  /// Durée par défaut en jours (ex. maternité 98) — pré-remplit le formulaire.
  defaultDurationDays   Int?     @map("default_duration_days")
  order                 Int      @default(0)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_types")
}

/// Demande de congé/absence d'un employé (workflow demande → validation).
model LeaveRequest {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  personId            String             @map("person_id") @db.Uuid
  leaveTypeId         String             @map("leave_type_id") @db.Uuid
  startDate           DateTime           @map("start_date") @db.Date
  endDate             DateTime           @map("end_date") @db.Date
  /// Nombre de jours décomptés (ouvrés).
  days                Float
  reason              String?
  justificationFileId String?            @map("justification_file_id") @db.Uuid
  status              LeaveRequestStatus @default(PENDING)
  reviewedByUserId    String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedAt          DateTime?          @map("reviewed_at")
  decisionComment     String?            @map("decision_comment")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person    Person    @relation("PersonLeaveRequests", fields: [personId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId, personId])
  @@index([tenantId, status])
  @@map("leave_requests")
}

// ─── RH : heures supplémentaires (Phase 3) ─────────────────────

enum OvertimeSource {
  TEACHING_OVER_QUOTA // heures de cours > quota hebdo
  SUBSTITUTION // remplacement
  PARASCOLAIRE // activités parascolaires
  AFTER_HOURS // personnel : heures après 18h
  EXAM_SUPERVISION // surveillance d'examens
  SPECIAL_EVENT // événements spéciaux
}

/// Chaîne de validation : déclaré → RH → Direction → Comptabilité.
enum OvertimeStatus {
  DECLARED
  RH_VALIDATED
  DIRECTION_APPROVED
  PROCESSED
  REJECTED
}

/// Heure supplémentaire d'un employé (un enregistrement = une occurrence datée).
model OvertimeEntry {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  personId          String         @map("person_id") @db.Uuid
  date              DateTime       @db.Date
  hours             Float
  source            OvertimeSource
  note              String?
  /// Réf. de l'origine (ex. id du TimetableOverride) — déduplication des générations auto.
  sourceRef         String?        @map("source_ref")
  status            OvertimeStatus @default(DECLARED)
  rhByUserId        String?        @map("rh_by_user_id") @db.Uuid
  directionByUserId String?        @map("direction_by_user_id") @db.Uuid
  processedByUserId String?        @map("processed_by_user_id") @db.Uuid
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation("PersonOvertime", fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, personId])
  @@index([tenantId, status])
  @@map("overtime_entries")
}

// ─── Comptabilité / Paie — Phase 1 : paramétrage ───────────────

/// Paramètres légaux de paie, VERSIONNÉS par date d'effet (droit marocain :
/// CNSS, AMO, barème IR, frais professionnels, ancienneté, heures sup, comptes).
/// Chaque run de paie utilise la config en vigueur pour son mois ; le bulletin
/// fige la config utilisée (snapshot) → l'historique ne se recalcule jamais.
model PayrollConfig {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  label         String?

  // Cotisations salariales
  cnssEmployeeRate Float @map("cnss_employee_rate") // ex. 0.0448
  cnssCeiling      Float @map("cnss_ceiling") // ex. 6000
  amoEmployeeRate  Float @map("amo_employee_rate") // ex. 0.0226 (déplafonné)

  // Cotisations patronales
  cnssEmployerRate    Float @map("cnss_employer_rate") // prestations sociales
  familyAllowanceRate Float @map("family_allowance_rate") // allocations familiales
  amoEmployerRate     Float @map("amo_employer_rate")
  trainingTaxRate     Float @map("training_tax_rate") // taxe de formation prof.

  // Frais professionnels (abattement avant IR)
  professionalExpenseRate           Float @map("professional_expense_rate") // ex. 0.20
  professionalExpenseCeilingMonthly Float @map("professional_expense_ceiling_monthly") // ex. 2500

  // Déductions pour charges de famille
  familyDeductionPerDependentMonthly Float @map("family_deduction_per_dependent_monthly")
  maxDependents                      Int   @map("max_dependents")

  /// Barème IR mensuel : [{ upTo: number|null, rate, deduction }].
  irBrackets     Json @map("ir_brackets")
  /// Majorations heures sup : { dayNormal, nightNormal, dayRest, nightRest }.
  overtimeMatrix Json @map("overtime_matrix")
  /// Barème d'ancienneté : [{ years, rate }].
  seniorityScale Json @map("seniority_scale")
  /// Mapping comptes CGNC : { salaries, socialCharges, netPayable, cnss, amo, ir, bank }.
  accountMapping Json @map("account_mapping")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, effectiveFrom])
  @@map("payroll_configs")
}

/// Profil de paie d'un employé : éléments fixes (salaire de base, indemnités,
/// n° CNSS, personnes à charge, CIMR). Les éléments variables (primes, HS,
/// absences) sont saisis au mois (Phase 2).
model EmployeePayrollProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  personId           String   @unique @map("person_id") @db.Uuid
  cnssNumber         String?  @map("cnss_number")
  baseSalary         Float    @default(0) @map("base_salary")
  transportAllowance Float    @default(0) @map("transport_allowance")
  housingAllowance   Float    @default(0) @map("housing_allowance")
  benefitsInKind     Float    @default(0) @map("benefits_in_kind")
  cimrEnabled        Boolean  @default(false) @map("cimr_enabled")
  cimrEmployeeRate   Float?   @map("cimr_employee_rate")
  numberOfDependents Int      @default(0) @map("number_of_dependents")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation("PersonPayrollProfile", fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("employee_payroll_profiles")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  RH_VALIDATED
  DIRECTION_APPROVED
  CLOSED
}

/// Run de paie mensuel : statut DRAFT→CALCULATED→RH→Direction→CLOSED.
/// `configSnapshot` fige les paramètres utilisés (immuabilité de l'historique).
model PayrollRun {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  year              Int
  month             Int
  status            PayrollRunStatus @default(DRAFT)
  configSnapshot    Json?            @map("config_snapshot")
  rhByUserId        String?          @map("rh_by_user_id") @db.Uuid
  directionByUserId String?          @map("direction_by_user_id") @db.Uuid
  closedByUserId    String?          @map("closed_by_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([tenantId, year, month])
  @@map("payroll_runs")
}

/// Bulletin de paie d'un employé pour un run : snapshot complet du calcul.
model Payslip {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  personId     String   @map("person_id") @db.Uuid
  brut         Float
  netImposable Float    @map("net_imposable")
  irNet        Float    @map("ir_net")
  netPayable   Float    @map("net_payable")
  employerCost Float    @map("employer_cost")
  breakdown    Json
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  person Person     @relation("PersonPayslips", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([runId, personId])
  @@index([tenantId, personId])
  @@map("payslips")
}

// ─── Bourse aux livres (dépôt-vente de manuels) ────────────────

enum BookCondition {
  NEW
  VERY_GOOD
  GOOD
  FAIR
}

enum BookCopySource {
  SCHOOL_NEW // exemplaire neuf de l'école (pas de vendeur)
  STUDENT_USED // occasion déposée par un élève
}

enum BookCopyStatus {
  DEPOSITED
  FOR_SALE
  RESERVED
  SOLD
  WITHDRAWN
  REFUNDED
}

enum BookCampaignStatus {
  OPEN
  CLOSED
}

enum BookTransactionType {
  SALE
  REFUND
}

enum BookRefundMode {
  CASH // remboursement en caisse
  FEE_CREDIT // défalcation sur une échéance à venir
}

/// Paramétrage de la bourse (un par établissement).
model BookExchangeConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @unique @map("tenant_id") @db.Uuid
  commissionMode     String   @default("PERCENT") @map("commission_mode") // PERCENT | FIXED
  commissionValue    Float    @default(0) @map("commission_value")
  /// Prix bourse auto = prix neuf × facteur selon l'état : { NEW, VERY_GOOD, GOOD, FAIR }.
  pricingByCondition Json     @map("pricing_by_condition")
  labelPrefix        String   @default("BRS") @map("label_prefix")
  /// Mapping comptes CGNC : { cash, sales, sellerPayables }.
  accountMapping     Json     @map("account_mapping")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("book_exchange_configs")
}

/// Campagne saisonnière (rentrée) : scope les exemplaires et transactions.
model BookExchangeCampaign {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  label     String
  year      Int
  status    BookCampaignStatus @default(OPEN)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copies       BookCopy[]
  transactions BookTransaction[]

  @@index([tenantId])
  @@map("book_exchange_campaigns")
}

/// Référence d'un manuel (titre). Les exemplaires physiques = BookCopy.
model Book {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  title              String
  subjectId          String?  @map("subject_id") @db.Uuid
  levelId            String?  @map("level_id") @db.Uuid
  editor             String?
  isbn               String?
  editionYear        Int?     @map("edition_year")
  priceNew           Float    @default(0) @map("price_new")
  priceBourseDefault Float?   @map("price_bourse_default")
  photoFileId        String?  @map("photo_file_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  level   Level?     @relation(fields: [levelId], references: [id], onDelete: SetNull)
  copies  BookCopy[]

  @@index([tenantId])
  @@index([tenantId, levelId])
  @@map("books")
}

/// Exemplaire physique : code unique (étiquette), état, vendeur, statut.
model BookCopy {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  bookId     String          @map("book_id") @db.Uuid
  campaignId String          @map("campaign_id") @db.Uuid
  code       String
  condition  BookCondition
  source     BookCopySource  @default(STUDENT_USED)
  sellerId   String?         @map("seller_id") @db.Uuid
  askPrice   Float           @map("ask_price")
  status     BookCopyStatus  @default(DEPOSITED)
  buyerId    String?         @map("buyer_id") @db.Uuid
  salePrice  Float?          @map("sale_price")
  commission Float?
  soldAt     DateTime?       @map("sold_at")
  refundedAt DateTime?       @map("refunded_at")
  refundMode BookRefundMode? @map("refund_mode")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book         Book                 @relation(fields: [bookId], references: [id], onDelete: Cascade)
  campaign     BookExchangeCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  seller       Person?              @relation("BookSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  buyer        Person?              @relation("BookBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  transactions BookTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, bookId])
  @@map("book_copies")
}

/// Mouvement de caisse : vente ou remboursement.
model BookTransaction {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  campaignId       String              @map("campaign_id") @db.Uuid
  copyId           String              @map("copy_id") @db.Uuid
  type             BookTransactionType
  amount           Float
  method           String? // CASH | CHEQUE | TRANSFER | CMI
  note             String?
  recordedByUserId String?             @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign BookExchangeCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  copy     BookCopy             @relation(fields: [copyId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("book_transactions")
}

// ─── Comptabilité — grand livre central (CGNC) ─────────────────

enum FiscalYearStatus {
  OPEN
  CLOSED
}

/// Journaux obligatoires : Ventes, Achats, Banque, Caisse, Paie, Opérations diverses.
enum AccountingJournal {
  VE
  AC
  BQ
  CA
  PA
  OD
}

/// Exercice comptable.
model FiscalYear {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  label     String
  startDate DateTime         @map("start_date") @db.Date
  endDate   DateTime         @map("end_date") @db.Date
  status    FiscalYearStatus @default(OPEN)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries JournalEntry[]

  @@index([tenantId])
  @@map("fiscal_years")
}

/// Compte du plan comptable (CGNC), configurable par l'établissement.
model Account {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  code         String
  name         String
  /// Compte de tiers lettrable (clients 342x, fournisseurs 441x).
  reconcilable Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accounts")
}

/// Écriture comptable (équilibrée : Σ débit = Σ crédit). Liée à sa pièce source.
model JournalEntry {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  fiscalYearId   String            @map("fiscal_year_id") @db.Uuid
  journal        AccountingJournal
  date           DateTime          @db.Date
  label          String
  reference      String?
  /// Pièce métier d'origine (idempotence + traçabilité) : ex. "Payment"/id.
  sourceType     String?           @map("source_type")
  sourceId       String?           @map("source_id")
  postedByUserId String?           @map("posted_by_user_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  lines      JournalLine[]

  @@index([tenantId, journal, date])
  @@index([tenantId, sourceType, sourceId])
  @@map("journal_entries")
}

/// Ligne d'écriture (un mouvement débit OU crédit sur un compte).
model JournalLine {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  entryId   String   @map("entry_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  debit     Decimal  @default(0) @db.Decimal(14, 2)
  credit    Decimal  @default(0) @db.Decimal(14, 2)
  label     String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId, accountId])
  @@index([entryId])
  @@map("journal_lines")
}

// ─── Comptabilité — Achats / Fournisseurs ──────────────────────

enum SupplierInvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  ice       String? // Identifiant Commun de l'Entreprise (Maroc)
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices SupplierInvoice[]

  @@index([tenantId])
  @@map("suppliers")
}

/// Facture fournisseur (comptabilité d'engagement : dette 4411 à la saisie).
model SupplierInvoice {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  supplierId       String                @map("supplier_id") @db.Uuid
  number           String?
  label            String
  /// Compte de charge (classe 6) imputé.
  accountCode      String                @map("account_code")
  amount           Decimal               @db.Decimal(12, 2)
  date             DateTime              @db.Date
  dueDate          DateTime              @map("due_date") @db.Date
  status           SupplierInvoiceStatus @default(UNPAID)
  note             String?
  recordedByUserId String?               @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  payments SupplierPayment[]

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("supplier_invoices")
}

model SupplierPayment {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  invoiceId        String        @map("invoice_id") @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  date             DateTime      @db.Date
  reference        String?
  recordedByUserId String?       @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("supplier_payments")
}

// ─── Radiation / transfert (workflow Vie scolaire → Compta → Direction) ──

enum RadiationType {
  TRANSFERT
  DEPART
  AUTRE
}

enum RadiationStatus {
  REQUESTED // demande du parent / administration
  VIE_SCOLAIRE_OK // situation vérifiée
  COMPTA_OK // paiements validés
  APPROVED // direction valide → élève transféré, certificat dispo
  REJECTED
}

model RadiationRequest {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  enrollmentId        String          @map("enrollment_id") @db.Uuid
  studentId           String          @map("student_id") @db.Uuid
  type                RadiationType   @default(TRANSFERT)
  reason              String?
  destinationSchool   String?         @map("destination_school")
  status              RadiationStatus @default(REQUESTED)
  debtCleared         Boolean         @default(false) @map("debt_cleared")
  /// Relevé des notes demandé à générer à la validation.
  noteRequested       Boolean         @default(false) @map("note_requested")
  requestedByUserId   String?         @map("requested_by_user_id") @db.Uuid
  vieScolaireByUserId String?         @map("vie_scolaire_by_user_id") @db.Uuid
  comptaByUserId      String?         @map("compta_by_user_id") @db.Uuid
  directionByUserId   String?         @map("direction_by_user_id") @db.Uuid
  vieScolaireComment  String?         @map("vie_scolaire_comment")
  comptaComment       String?         @map("compta_comment")
  directionComment    String?         @map("direction_comment")
  vieScolaireAt       DateTime?       @map("vie_scolaire_at")
  comptaAt            DateTime?       @map("compta_at")
  /// Documents (attestation, certificat, relevé) générés à la validation.
  docsGeneratedAt     DateTime?       @map("docs_generated_at")
  rejectionReason     String?         @map("rejection_reason")
  approvedAt          DateTime?       @map("approved_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student    Person           @relation("StudentRadiations", fields: [studentId], references: [id], onDelete: Cascade)
  refund     RadiationRefund?

  @@index([tenantId, status])
  @@map("radiation_requests")
}

/// Statut du sous-workflow de remboursement (départ en cours d'année).
enum RefundStatus {
  PENDING_CHECK // vie scolaire a validé → compta doit vérifier
  CALCULATED // compta a calculé le montant → direction doit valider
  APPROVED // direction a validé (montant proposé ou corrigé)
  PAID // remboursement payé + reçu généré
  REJECTED // aucun remboursement dû / refusé
}

enum RefundMethod {
  VIREMENT
  CHEQUE
  ESPECES
}

/// Base de calcul des frais consommés (choisie par la comptabilité).
enum RefundBasis {
  INSTALLMENT // échéances dont la date est déjà passée
  PRORATA // au prorata des mois écoulés de l'année
}

/// Remboursement lié à une radiation en cours d'année.
model RadiationRefund {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  radiationRequestId String        @unique @map("radiation_request_id") @db.Uuid
  studentId          String        @map("student_id") @db.Uuid
  status             RefundStatus  @default(PENDING_CHECK)
  basis              RefundBasis   @default(INSTALLMENT)
  paidTotal          Decimal       @default(0) @map("paid_total") @db.Decimal(12, 2)
  consumedTotal      Decimal       @default(0) @map("consumed_total") @db.Decimal(12, 2)
  computedAmount     Decimal       @default(0) @map("computed_amount") @db.Decimal(12, 2)
  approvedAmount     Decimal?      @map("approved_amount") @db.Decimal(12, 2)
  method             RefundMethod?
  reference          String?
  /// Détail par catégorie (payé / consommé / remboursable) pour le reçu.
  breakdown          Json?
  comptaByUserId     String?       @map("compta_by_user_id") @db.Uuid
  directionByUserId  String?       @map("direction_by_user_id") @db.Uuid
  directionComment   String?       @map("direction_comment")
  paidByUserId       String?       @map("paid_by_user_id") @db.Uuid
  approvedAt         DateTime?     @map("approved_at")
  paidAt             DateTime?     @map("paid_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request RadiationRequest @relation(fields: [radiationRequestId], references: [id], onDelete: Cascade)
  student Person           @relation("StudentRefunds", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("radiation_refunds")
}

/// Alerte in-app destinée à un utilisateur du personnel (la cloche de l'en-tête).
model StaffAlert {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String // ex : RADIATION_STEP, REFUND_CHECK, GENERIC
  title       String
  body        String?
  link        String?
  relatedType String?   @map("related_type")
  relatedId   String?   @map("related_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@map("staff_alerts")
}

// ─── Compétences & aptitudes (approche par compétences, APC) ───────────────

enum CompetencyKind {
  DISCIPLINARY // rattachée à une matière
  TRANSVERSAL // aptitude transversale, évaluable par tout enseignant
}

enum FrameworkStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssessmentSource {
  CLASS // saisie depuis une classe
  SUPPORT // saisie depuis une séance de soutien
  REPORT // consolidation lors d'un bilan
}

/// Référentiel de compétences, versionné par année scolaire.
model CompetencyFramework {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  /// Null pour le référentiel MODÈLE de l'établissement : il ne dépend pas
  /// d'une année et sert de source aux référentiels annuels.
  academicYearId String?         @map("academic_year_id") @db.Uuid
  /// Référentiel modèle, éditable en continu dans Paramétrage. Un seul par
  /// établissement ; les référentiels d'année en sont des copies figées.
  isTemplate     Boolean         @default(false) @map("is_template")
  label          String
  version        Int             @default(1)
  status         FrameworkStatus @default(DRAFT)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear?    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  nodes        CompetencyNode[]
  reports      CompetencyReport[]

  @@unique([tenantId, academicYearId, version])
  @@index([tenantId, status])
  @@map("competency_frameworks")
}

/// Arbre unique domaine → compétence → sous-compétence (profondeur variable).
/// Les aptitudes transversales sont des nœuds `kind = TRANSVERSAL` sans matière.
model CompetencyNode {
  supportSessions SupportSessionSkill[]
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  frameworkId String         @map("framework_id") @db.Uuid
  parentId    String?        @map("parent_id") @db.Uuid
  kind        CompetencyKind
  labelFr     String         @map("label_fr")
  labelAr     String?        @map("label_ar")
  /// Indicateur observable affiché à l'enseignant lors de la saisie.
  descriptor  String?
  /// Matière pilote : détermine qui peut évaluer. Null = ouvert à tous les
  /// enseignants. Hérité du plus proche ancêtre qui en porte une.
  subjectId   String?        @map("subject_id") @db.Uuid
  depth       Int            @default(0)
  order       Int            @default(0)
  /// Seules les feuilles sont réellement évaluables.
  isLeaf      Boolean        @default(false) @map("is_leaf")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  framework   CompetencyFramework    @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  parent      CompetencyNode?        @relation("CompetencyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    CompetencyNode[]       @relation("CompetencyTree")
  subject     Subject?               @relation(fields: [subjectId], references: [id])
  levels      CompetencyNodeLevel[]
  assessments CompetencyAssessment[]

  @@index([tenantId, frameworkId, kind])
  @@index([tenantId, parentId])
  @@map("competency_nodes")
}

/// Activation d'un nœud pour un niveau scolaire.
/// Aucune ligne = le nœud s'applique à tous les niveaux.
model CompetencyNodeLevel {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  nodeId   String @map("node_id") @db.Uuid
  levelId  String @map("level_id") @db.Uuid

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  node   CompetencyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  level  Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([nodeId, levelId])
  @@index([tenantId, levelId])
  @@map("competency_node_levels")
}

/// Échelle de maîtrise configurable (NA / ECA / A / M par défaut).
model MasteryLevel {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  labelFr  String  @map("label_fr")
  labelAr  String? @map("label_ar")
  /// Valeur numérique servant aux moyennes et pourcentages (NA=0 … M=3).
  value    Int
  color    String  @default("#94a3b8")
  order    Int     @default(0)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessments CompetencyAssessment[]

  @@unique([tenantId, code])
  @@map("mastery_levels")
}

/// Évaluation d'un élève sur une feuille de l'arbre, pour une période donnée.
/// Une ligne par enseignant : la synthèse se fait par moyenne des valeurs.
model CompetencyAssessment {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  studentId         String           @map("student_id") @db.Uuid
  nodeId            String           @map("node_id") @db.Uuid
  periodId          String           @map("period_id") @db.Uuid
  masteryLevelId    String           @map("mastery_level_id") @db.Uuid
  comment           String?
  source            AssessmentSource @default(CLASS)
  supportSessionId  String?          @map("support_session_id") @db.Uuid
  evaluatedByUserId String           @map("evaluated_by_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Person          @relation("StudentCompetencyAssessments", fields: [studentId], references: [id], onDelete: Cascade)
  node           CompetencyNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  period         Period          @relation(fields: [periodId], references: [id], onDelete: Cascade)
  mastery        MasteryLevel    @relation(fields: [masteryLevelId], references: [id])
  supportSession SupportSession? @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)

  @@unique([studentId, nodeId, periodId, evaluatedByUserId])
  @@index([tenantId, periodId, nodeId])
  @@index([tenantId, studentId, periodId])
  @@map("competency_assessments")
}

/// Bilan de compétences figé pour un élève et une période.
/// Indispensable à la reproductibilité : sans ce gel, le PDF d'un trimestre
/// changerait si un enseignant saisit une évaluation des mois plus tard.
model CompetencyReport {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  studentId   String @map("student_id") @db.Uuid
  periodId    String @map("period_id") @db.Uuid
  frameworkId String @map("framework_id") @db.Uuid
  /// Synthèse figée : domaines → compétences → taux, couverture, items.
  data        Json
  /// Taux globaux au moment du gel (0–100), null si aucune évaluation.
  disciplinaryRate  Float? @map("disciplinary_rate")
  transversalRate   Float? @map("transversal_rate")
  generatedByUserId String? @map("generated_by_user_id") @db.Uuid
  generatedAt       DateTime @default(now()) @map("generated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Person              @relation("StudentCompetencyReports", fields: [studentId], references: [id], onDelete: Cascade)
  period    Period              @relation(fields: [periodId], references: [id], onDelete: Cascade)
  framework CompetencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([studentId, periodId])
  @@index([tenantId, periodId])
  @@map("competency_reports")
}

/// Compétences ciblées par une séance de soutien.
/// Permet de mesurer l'impact des séances sur les acquis, et — via la
/// remédiation ciblée — de constituer un groupe à partir d'une compétence.
model SupportSessionSkill {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  supportSessionId String @map("support_session_id") @db.Uuid
  nodeId           String @map("node_id") @db.Uuid

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session SupportSession @relation(fields: [supportSessionId], references: [id], onDelete: Cascade)
  node    CompetencyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([supportSessionId, nodeId])
  @@index([tenantId, nodeId])
  @@map("support_session_skills")
}


// ─── Examens certificatifs & sessions d'examen ─────────────────────────────
//
// Le contrôle continu existe déjà (Evaluation/Grade). Ce bloc ajoute les
// examens du lycée marocain : semestriel local, Régional (1BAC) et National
// (2BAC), avec la filière comme pivot — c'est elle qui porte les coefficients
// et qui détermine les épreuves applicables à un élève.

/// Nature d'une épreuve dans le calcul de la moyenne.
enum ExamKind {
  SEMESTRIEL // examen semestriel local
  REGIONAL // examen régional (1ère année Bac)
  NATIONAL // examen national (2ème année Bac)
  BLANC // examen blanc (entraînement, pondération à part)
}

enum ExamSessionStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// Filière / option / spécialité (TC Sciences, 1BAC SMA, 2BAC SVT…).
/// Rattachée à un niveau : au Maroc, « 2BAC SVT » n'a de sens qu'en 2BAC.
/// C'est la filière qui porte les coefficients réglementaires, pas le niveau
/// seul — deux élèves de 1BAC n'ont pas le même coefficient en maths.
model Track {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  levelId   String   @map("level_id") @db.Uuid
  code      String // "1bac-sma", "tc-sciences"
  label     String
  labelAr   String?  @map("label_ar")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level        Level                     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  coefficients TrackSubjectCoefficient[]
  classes      Class[]
  enrollments  Enrollment[]
  gradingRules GradingRule[]
  examSessions ExamSessionTrack[]
  blueprints   ExamBlueprint[]
  examPapers   ExamPaperTrack[]

  @@unique([tenantId, code])
  @@index([tenantId, levelId])
  @@map("tracks")
}

/// Coefficient d'une matière dans une filière. Prime sur
/// CurriculumSubject.coefficient, lui-même prioritaire sur Subject.coefficient.
model TrackSubjectCoefficient {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  trackId     String  @map("track_id") @db.Uuid
  subjectId   String  @map("subject_id") @db.Uuid
  /// Coefficient de l'EXAMEN certificatif (Bac national/régional).
  coefficient Float   @default(1)
  /// Volume horaire hebdomadaire au programme de la filière.
  weeklyHours Float?  @map("weekly_hours")
  /// Coefficient du CONTRÔLE CONTINU (moyenne semestrielle). Au lycée
  /// marocain il suit le volume horaire, et diffère du coefficient d'examen
  /// (en 2BAC SMA : 7 en contrôle continu, 9 au Bac).
  ccCoefficient Float? @map("cc_coefficient")
  /// Matière évaluée à l'épreuve certificative (régionale ou nationale) de
  /// cette filière — sert à filtrer les épreuves applicables (RF-01.2).
  certifying  Boolean @default(false)
  order       Int     @default(0)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([trackId, subjectId])
  @@index([tenantId, trackId])
  @@map("track_subject_coefficients")
}

/// Pondération réglementaire CC / semestriel / régional / national, par niveau
/// et éventuellement par filière, sur une année scolaire donnée.
/// `trackId` null = règle par défaut du niveau (unicité garantie côté action :
/// Postgres considère deux NULL comme distincts).
model GradingRule {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  academicYearId String  @map("academic_year_id") @db.Uuid
  levelId        String  @map("level_id") @db.Uuid
  trackId        String? @map("track_id") @db.Uuid
  /// Pourcentages, somme attendue = 100.
  ccWeight       Float   @default(0) @map("cc_weight")
  semesterWeight Float   @default(0) @map("semester_weight")
  regionalWeight Float   @default(0) @map("regional_weight")
  nationalWeight Float   @default(0) @map("national_weight")
  /// Verrou de saisie : à la clôture, plus aucune note n'entre (RF-01.3).
  locked         Boolean @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level        Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  track        Track?       @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([tenantId, academicYearId, levelId])
  @@map("grading_rules")
}

/// Session d'examen : un ensemble d'épreuves pour un niveau et des filières,
/// sur une plage de dates (RF-02.1).
model ExamSession {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  academicYearId String            @map("academic_year_id") @db.Uuid
  levelId        String            @map("level_id") @db.Uuid
  /// Période (semestre) à laquelle la session se rattache pour le calcul.
  periodId       String?           @map("period_id") @db.Uuid
  label          String
  labelAr        String?           @map("label_ar")
  kind           ExamKind
  startDate      DateTime          @map("start_date") @db.Date
  endDate        DateTime          @map("end_date") @db.Date
  status         ExamSessionStatus @default(DRAFT)
  /// Mélanger les classes/filières à la répartition en salle (anti-fraude).
  mixClasses     Boolean           @default(true) @map("mix_classes")
  /// Générer des numéros d'anonymat pour les copies (RF-05.1).
  anonymized     Boolean           @default(true)
  publishedAt    DateTime?         @map("published_at")
  closedAt       DateTime?         @map("closed_at")
  closedByUserId String?           @map("closed_by_user_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level        Level              @relation(fields: [levelId], references: [id], onDelete: Cascade)
  period       Period?            @relation(fields: [periodId], references: [id])
  tracks       ExamSessionTrack[]
  papers       ExamPaper[]

  @@index([tenantId, academicYearId, levelId])
  @@map("exam_sessions")
}

/// Filières concernées par une session (une session 1BAC peut couvrir SMA+SP).
model ExamSessionTrack {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  trackId   String @map("track_id") @db.Uuid

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  track   Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([sessionId, trackId])
  @@map("exam_session_tracks")
}

/// Une épreuve : matière, date, heure, durée, coefficient (RF-02.2).
model ExamPaper {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  date        DateTime @db.Date
  /// Heure de début, format "HH:MM" — même convention que TimetableSlot.
  startTime   String   @map("start_time")
  durationMin Int      @map("duration_min")
  coefficient Float    @default(1)
  maxValue    Float    @default(20) @map("max_value")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session     ExamSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject     Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  allocations ExamRoomAllocation[]
  seats       ExamSeat[]
  graders     ExamGrader[]
  tracks      ExamPaperTrack[]
  marks       ExamMark[]

  @@unique([sessionId, subjectId, date, startTime])
  @@index([tenantId, sessionId])
  @@map("exam_papers")
}

/// Salle réservée pour une épreuve, avec sa capacité « examen » (RF-03.1),
/// distincte de la capacité de cours (1 élève par table).
model ExamRoomAllocation {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  paperId      String @map("paper_id") @db.Uuid
  roomId       String @map("room_id") @db.Uuid
  examCapacity Int    @map("exam_capacity")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paper       ExamPaper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  room        Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  supervisors ExamSupervisor[]
  seats       ExamSeat[]

  @@unique([paperId, roomId])
  @@index([tenantId, paperId])
  @@map("exam_room_allocations")
}

/// Surveillant affecté à une salle pour une épreuve (RF-04.1).
model ExamSupervisor {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  allocationId String   @map("allocation_id") @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  /// Responsable de salle (un seul par salle) ou surveillant d'appoint.
  lead         Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocation ExamRoomAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  teacher    Person             @relation("ExamSupervisions", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([allocationId, teacherId])
  @@index([tenantId, teacherId])
  @@map("exam_supervisors")
}

/// Place d'un élève à une épreuve : salle, numéro de table, anonymat.
model ExamSeat {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  paperId       String  @map("paper_id") @db.Uuid
  allocationId  String  @map("allocation_id") @db.Uuid
  studentId     String  @map("student_id") @db.Uuid
  seatNumber    Int     @map("seat_number")
  /// Numéro d'anonymat de la copie (RF-05.1). Null si session non anonymisée.
  anonymousCode String? @map("anonymous_code")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paper      ExamPaper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  allocation ExamRoomAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  student    Person             @relation("ExamSeats", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([paperId, studentId])
  @@unique([paperId, anonymousCode])
  @@index([tenantId, paperId])
  @@map("exam_seats")
}

/// Correcteur d'une épreuve, avec son lot de copies (RF-04.2).
model ExamGrader {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  paperId   String   @map("paper_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  /// Bornes du lot attribué (numéros d'anonymat ou de place). Null = tout.
  lotFrom   Int?     @map("lot_from")
  lotTo     Int?     @map("lot_to")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  teacher Person    @relation("ExamGradings", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([paperId, teacherId])
  @@index([tenantId, teacherId])
  @@map("exam_graders")
}

/// Note d'un élève à une épreuve (RF-05.2).
model ExamMark {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  paperId         String   @map("paper_id") @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  value           Float?
  absent          Boolean  @default(false)
  enteredByUserId String?  @map("entered_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student Person    @relation("ExamMarks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([paperId, studentId])
  @@index([tenantId, studentId])
  @@map("exam_marks")
}

/// Nature d'une épreuve dans la maquette du Bac : spécialité (le cœur de la
/// filière), secondaire (matière scientifique/technique non spécialisée), ou
/// littéraire (tronc littéraire commun).
enum ExamPaperType {
  SPECIALITY
  SECONDARY
  LITERARY
}

/// Maquette d'épreuve : pour une filière et une matière, la durée
/// réglementaire, le type, et le **groupe de sujet partagé**.
///
/// La distinction qui commande toute l'organisation :
///  - même `paperGroup` + même matière  → **épreuve identique** : un seul
///    sujet, une seule épreuve à planifier pour toutes ces filières ;
///  - `paperGroup` null → sujet propre à la filière, même si la durée est
///    identique à celle d'une autre filière (cas SVT en SMA/SMB/SP, ou
///    Gestion en Économie/TGC : même durée, sujets différents).
model ExamBlueprint {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  trackId     String        @map("track_id") @db.Uuid
  subjectId   String        @map("subject_id") @db.Uuid
  durationMin Int           @map("duration_min")
  type        ExamPaperType
  /// Code de regroupement des sujets identiques (ex. « sci-lit »).
  paperGroup  String?       @map("paper_group")
  order       Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([trackId, subjectId])
  @@index([tenantId, trackId])
  @@map("exam_blueprints")
}

/// Filières couvertes par une épreuve. Une épreuve mutualisée (Arabe des
/// filières scientifiques) en porte plusieurs ; une épreuve de spécialité une
/// seule. Vide = toutes les filières de la session (compatibilité avec les
/// épreuves créées avant la mutualisation).
model ExamPaperTrack {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  paperId  String @map("paper_id") @db.Uuid
  trackId  String @map("track_id") @db.Uuid

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paper  ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  track  Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([paperId, trackId])
  @@index([tenantId, trackId])
  @@map("exam_paper_tracks")
}
