model Level {
  competencyNodeLevels CompetencyNodeLevel[]
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cycleId   String   @map("cycle_id") @db.Uuid
  code      String // "cp", "ce1", "6eme", "l1", ...
  label     String
  /// Libellé arabe du niveau (ex. « الأولى إعدادي »), pour bulletins et
  /// documents en arabe.
  labelAr   String?  @map("label_ar")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle              Cycle               @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  classes            Class[]
  feeSchedules       FeeScheduleItem[]
  curriculumSubjects CurriculumSubject[]
  enrollments        Enrollment[]
  admissionQuotas    AdmissionQuota[]
  requiredDocuments  RequiredDocument[]
  books              Book[]
  tracks             Track[]
  gradingRules       GradingRule[]
  examSessions       ExamSession[]

