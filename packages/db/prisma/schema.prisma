// ───────────────────────────────────────────────────────────
// Jawal — Schéma Prisma initial (Module Core)
// Multi-tenant : toutes les tables métier portent tenant_id
// Isolation : Row-Level Security PostgreSQL (voir migration init)
// ───────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

// ─── Énumérations ──────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  ARCHIVED
}

enum TenantProfile {
  K12              // Primaire/secondaire
  SUPERIEUR        // Enseignement supérieur
  FORMATION_PRO    // Formation professionnelle
  MIXED            // Établissement multi-segments
}

enum PersonType {
  STUDENT
  PARENT
  TEACHER
  STAFF
}

enum RelationType {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
  GUARDIAN
}

enum ContractType {
  CDI          // Contrat à durée indéterminée
  CDD          // Contrat à durée déterminée
  VACATAIRE    // Vacataire / Heures supp.
  STAGIAIRE    // Stage
  AUTRE
}

/// Mode de paiement du SALAIRE (distinct de PaymentMethod qui sert aux
/// encaissements élèves/parents).
enum PayrollPaymentMethod {
  BANK_TRANSFER
  CHECK
  CASH
  OTHER
}

enum Gender {
  M
  F
  X
}

enum PeriodKind {
  TRIMESTER
  SEMESTER
  YEAR
  MODULE
  SESSION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED // dispense, sortie anticipée, retrait justifié
}

/// Statut de pointage du personnel (enseignants ou administratif).
/// EXCUSED couvre congés, maladies, formations — sans retenue. ABSENT non
/// excusé déclenche une retenue calculée pro-rata sur le salaire mensuel.
enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  LEAVE     // Congé / RTT planifié
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstallmentStatus {
  PENDING    // due, non payé
  PARTIAL    // partiellement payé
  PAID       // intégralement payé
  CANCELLED  // annulé (ex: élève parti)
}

/// Cycle de vie d'une inscription. DRAFT = préinscription en attente de
/// validation. ACTIVE = élève inscrit (StudentClass + échéancier générés).
/// WITHDRAWN = retrait en cours d'année. GRADUATED = clôture par succès.
enum EnrollmentStatus {
  DRAFT
  ACTIVE
  WITHDRAWN
  GRADUATED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

/// Type d'exception ponctuelle sur une case d'EDT pour une date précise.
///  - CANCELLED : le cours n'a pas lieu ce jour-là
///  - SUBSTITUTION : remplaçant (teacher) ou changement de salle (room) ou
///    de matière, le reste de la semaine type reste inchangé
enum TimetableOverrideKind {
  CANCELLED
  SUBSTITUTION
}

/// Types de contraintes paramétrables qui pilotent le solveur d'EDT.
///
/// MAX_SAME_SUBJECT_PER_DAY (hard)
///   config: { max: int } — applique à toutes les classes : max N heures
///   d'une même matière sur la même journée pour la même classe.
///   Évite « 2× Maths le lundi ».
///
/// NO_GAPS (soft, poids élevé)
///   config: { weight: int } — pénalise tout pattern « cours … vide … cours »
///   dans la journée d'une classe. Réduit les heures creuses.
///
/// REQUIRES_CONSECUTIVE_SUBJECTS (hard)
///   config: { subjectIds: string[] } — pour ces matières, si weekly_hours
///   ≥ 2, force les séances à être consécutives par paires (blocs 2h).
///
/// MAX_HOURS_PER_DAY_TEACHER (hard)
///   config: { max: int } — chaque prof a au plus N heures de cours par jour.
///
/// MAX_CONSECUTIVE_HOURS_TEACHER (hard, phase 4E3)
///   config: { max: int } — chaque prof a au plus N heures de cours d'affilée
///   (au-delà, une pause est imposée dans la journée).
///
/// TEACHER_LUNCH_BREAK (hard, phase 4E3)
///   config: { from: "HH:MM", to: "HH:MM" } — chaque prof garde au moins un
///   créneau libre dans la plage déjeuner les jours où il enseigne (déjeuner
///   échelonné, sans bloquer la plage pour tout le monde).
///
/// REQUIRE_SUBJECT_ROOM_TYPE (hard, phase 4E4)
///   config: {} — les matières nécessitant un type de salle spécifique
///   (PC/SVT/Info/EPS, déduit par heuristique) ne sont placées que dans une
///   salle compatible. Sinon le cours reste non placé (diagnostic dédié).
///
/// MINIMIZE_ROOM_CHANGES (soft, phase 4E5)
///   config: { weight: int } — récompense le maintien de la même salle d'un
///   créneau au suivant pour une classe (moins de déménagements).
///
/// BALANCE_DAILY_LOAD (soft, phase 4E5)
///   config: { weight: int } — pénalise la journée la plus chargée de chaque
///   classe (répartit les heures, évite les journées trop longues).
enum TimetableConstraintKind {
  MAX_SAME_SUBJECT_PER_DAY
  NO_GAPS
  REQUIRES_CONSECUTIVE_SUBJECTS
  MAX_HOURS_PER_DAY_TEACHER
  MAX_CONSECUTIVE_HOURS_TEACHER
  TEACHER_LUNCH_BREAK
  REQUIRE_SUBJECT_ROOM_TYPE
  MINIMIZE_ROOM_CHANGES
  BALANCE_DAILY_LOAD
}

enum PaymentMethod {
  CASH       // espèces (caisse)
  CHEQUE
  TRANSFER   // virement
  CMI        // CMI sandbox/prod
  STRIPE
  OTHER
}

enum AnnouncementAudience {
  ALL              // tout l'établissement
  PARENTS          // tous les parents
  TEACHERS         // tous les enseignants
  STAFF            // personnel
  CLASS            // une classe spécifique (classId requis)
  LEVEL            // un niveau (levelId requis)
}

enum CouncilDecision {
  FELICITATIONS         // Mention spéciale pour excellents résultats
  ENCOURAGEMENTS        // Encouragements pour effort
  COMPLIMENTS           // Compliments simples
  AVERTISSEMENT_TRAVAIL // Avertissement travail insuffisant
  AVERTISSEMENT_COMP    // Avertissement comportement
  PASSAGE               // Passage en classe supérieure
  REDOUBLEMENT          // Redoublement
  ORIENTATION           // Réorientation conseillée
}

// ─── Tenants & modules ─────────────────────────────────────

model Tenant {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  name          String
  customDomain  String?       @unique @map("custom_domain")
  profile       TenantProfile @default(K12)
  status        TenantStatus  @default(TRIAL)
  localeDefault String        @default("fr") @map("locale_default")
  timezone      String        @default("Africa/Casablanca")
  currency      String        @default("MAD")
  settings      Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  modules        TenantModule[]
  users          User[]
  persons        Person[]
  roles          Role[]
  academicYears  AcademicYear[]
  cycles         Cycle[]
  levels         Level[]
  classes        Class[]
  rooms          Room[]
  periods        Period[]
  auditLogs      AuditLog[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  absenceJustifications AbsenceJustification[]
  subjects       Subject[]
  evaluations    Evaluation[]
  grades         Grade[]
  subjectAppreciations SubjectAppreciation[]
  councilEntries CouncilEntry[]
  announcements  Announcement[]
  conversations  Conversation[]
  messages       Message[]
  conversationParticipants ConversationParticipant[]
  feeSchedules   FeeScheduleItem[]
  installments   Installment[]
  payments       Payment[]
  files          FileObject[]
  personRoles    PersonRole[]
  personRelations PersonRelation[]
  teacherAssignments TeacherAssignment[]
  curriculumSubjects CurriculumSubject[]
  teacherSpecialties TeacherSpecialty[]
  teacherCycles      TeacherCycle[]
  diplomas           Diploma[]
  staffAttendance    StaffAttendance[]
  enrollments        Enrollment[]
  timetableSlots     TimetableSlot[]
  timetableEntries   TimetableEntry[]
  timetableOverrides TimetableOverride[]
  timetableConstraints TimetableConstraint[]

  @@map("tenants")
}

model TenantModule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   // ex: "core", "admissions", "notes"
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("tenant_modules")
}

// ─── Auth & identités ──────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  email         String    @db.Citext
  passwordHash  String?   @map("password_hash")
  emailVerified DateTime? @map("email_verified")
  mfaSecret     String?   @map("mfa_secret")
  /// Super-admin SaaS — bypasse l'isolation tenant (gère tous les tenants).
  /// Reste rattaché à un tenant pour les contraintes de schéma mais ses
  /// opérations utilisent le client `prismaAdmin` (superuser PostgreSQL).
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  locale        String    @default("fr")
  lastLoginAt   DateTime? @map("last_login_at")
  disabledAt    DateTime? @map("disabled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  userPersons UserPerson[]
  auditLogs   AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Person {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  type        PersonType
  /// Catégorie paramétrable (TEACHER ou STAFF uniquement). Null sinon.
  roleId      String?    @map("role_id") @db.Uuid
  firstName   String     @map("first_name")
  lastName    String     @map("last_name")
  birthDate   DateTime?  @map("birth_date") @db.Date
  gender      Gender?
  nationality String?
  cin         String?    // CIN / passeport
  contacts    Json       @default("{}") // { email, phone, ... }
  address     Json       @default("{}")
  metadata    Json       @default("{}")
  /// Date d'entrée en fonction (TEACHER/STAFF). Null pour STUDENT/PARENT.
  hireDate       DateTime?     @map("hire_date") @db.Date
  /// Date de sortie / fin de contrat. Null = encore en poste.
  contractEndDate DateTime?    @map("contract_end_date") @db.Date
  contractType   ContractType? @map("contract_type")
  /// Volume horaire contractuel hebdomadaire (TEACHER uniquement).
  /// Indépendant des heures réellement enseignées (TeacherAssignment) et
  /// des disponibilités horaires (availability). Sert au KPI de couverture
  /// horaire de l'établissement (capacité totale dispo pour le solveur EDT).
  contractualHoursPerWeek Int?   @map("contractual_hours_per_week")
  /// PDF du contrat — stocké dans MinIO via FileObject.
  contractFileId String?       @unique @map("contract_file_id") @db.Uuid
  /// RH — uniquement TEACHER/STAFF
  experienceYears Int?         @map("experience_years")
  /// JSON : grille hebdomadaire de disponibilités { MON: [{from,to}], ... }
  availability    Json         @default("{}") @map("availability")
  /// Données financières — uniquement TEACHER/STAFF
  rib             String?
  bankName        String?      @map("bank_name")
  payrollMethod   PayrollPaymentMethod? @map("payroll_method")
  grossSalary     Decimal?     @map("gross_salary") @db.Decimal(12, 2)
  netSalary       Decimal?     @map("net_salary") @db.Decimal(12, 2)
  /// JSON : avantages [{label, amount}]
  benefits        Json         @default("[]")
  /// JSON : retenues [{label, amount, date?}]
  deductions      Json         @default("[]")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role               PersonRole?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  contractFile       FileObject?        @relation("ContractFile", fields: [contractFileId], references: [id], onDelete: SetNull)
  userPersons        UserPerson[]
  studentClasses     StudentClass[]
  mainOfClass        Class[]            @relation("MainTeacher")
  attendanceRecords  AttendanceRecord[] @relation("StudentAttendance")
  grades             Grade[]            @relation("StudentGrades")
  subjectAppreciations SubjectAppreciation[] @relation("StudentSubjectAppreciations")
  councilEntries     CouncilEntry[]     @relation("StudentCouncil")
  installments       Installment[]      @relation("StudentInstallments")
  teacherAssignments TeacherAssignment[] @relation("TeacherAssignments")
  teacherSpecialties TeacherSpecialty[]
  teacherCycles      TeacherCycle[]
  diplomas           Diploma[]
  staffAttendance    StaffAttendance[]   @relation("StaffAttendance")
  enrollments        Enrollment[]        @relation("StudentEnrollments")
  timetableEntries   TimetableEntry[]    @relation("TeacherTimetable")
  substitutionsAsTeacher TimetableOverride[] @relation("SubstituteTeacher")
  /// Liens de parenté où cette personne est l'enfant (FROM = student/PARENT-child)
  relationsAsChild   PersonRelation[]   @relation("ChildRelations")
  /// Liens où cette personne est le parent/tuteur (TO = parent/guardian)
  relationsAsParent  PersonRelation[]   @relation("ParentRelations")

  @@index([tenantId, type])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, roleId])
  @@index([tenantId, contractEndDate])
  @@map("persons")
}

/// Spécialités d'un enseignant : matières qu'il est capable d'enseigner
/// (vs TeacherAssignment qui est ce qu'il enseigne effectivement cette année).
model TeacherSpecialty {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  teacherId String @map("teacher_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Person  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([tenantId, teacherId])
  @@index([tenantId, subjectId])
  @@map("teacher_specialties")
}

/// Cycles enseignés par un enseignant (Primaire, Collège, Lycée…).
model TeacherCycle {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  cycleId   String   @map("cycle_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Person @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  cycle   Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([teacherId, cycleId])
  @@index([tenantId, teacherId])
  @@map("teacher_cycles")
}

/// Diplômes / certifications d'une personne (TEACHER ou STAFF).
model Diploma {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  personId    String   @map("person_id") @db.Uuid
  title       String   // ex : "Licence en mathématiques"
  institution String?  // ex : "Université Hassan II"
  year        Int?     // ex : 2018
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, personId])
  @@map("diplomas")
}

/// Affectation pédagogique : un enseignant enseigne une matière à une classe
/// donnée pour une année scolaire. Sert à filtrer la saisie de notes et de
/// base à l'emploi du temps.
model TeacherAssignment {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  teacherId       String   @map("teacher_id") @db.Uuid
  subjectId       String   @map("subject_id") @db.Uuid
  classId         String   @map("class_id") @db.Uuid
  academicYearId  String   @map("academic_year_id") @db.Uuid
  hoursPerWeek    Float?   @map("hours_per_week")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher      Person       @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId, academicYearId])
  @@index([tenantId, teacherId])
  @@index([tenantId, classId, academicYearId])
  @@index([tenantId, subjectId])
  @@map("teacher_assignments")
}

/// Catégorie paramétrable pour les enseignants ou le personnel.
/// Bilingue FR/AR — l'affichage choisit selon la locale active.
model PersonRole {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  appliesTo PersonType @map("applies_to") // TEACHER ou STAFF
  code      String     // identifiant stable (MAIN_TEACHER, BURSAR, ...)
  labelFr   String     @map("label_fr")
  labelAr   String     @map("label_ar")
  order     Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  persons Person[]

  @@unique([tenantId, code])
  @@index([tenantId, appliesTo, order])
  @@map("person_roles")
}

/// Lien explicite parent ↔ enfant (Père, Mère, Tuteur légal, Tuteur).
/// La fratrie est *déduite* via parents partagés (pas stockée).
model PersonRelation {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  /// Élève
  childId   String       @map("child_id") @db.Uuid
  /// Parent ou tuteur
  parentId  String       @map("parent_id") @db.Uuid
  type      RelationType
  createdAt DateTime     @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  child  Person @relation("ChildRelations", fields: [childId], references: [id], onDelete: Cascade)
  parent Person @relation("ParentRelations", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([childId, parentId])
  @@index([tenantId, childId])
  @@index([tenantId, parentId])
  @@map("person_relations")
}

/// Lien compte ↔ identité (un user peut représenter plusieurs persons,
/// ex. parent rattaché à plusieurs enfants).
model UserPerson {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  relationship String?   // self, father, mother, guardian, ...
  createdAt    DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([userId, personId])
  @@index([tenantId])
  @@map("user_persons")
}

// ─── RBAC ──────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   // tenant_admin, direction, scolarite, enseignant, parent, eleve, ...
  label       String
  permissions String[] // ex: ["notes.write", "bulletins.publish"]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  /// Restriction du rôle à un périmètre (ex: { "classes": ["uuid1", "uuid2"] })
  scope     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

// ─── Structure pédagogique ─────────────────────────────────

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  label     String   // "2025-2026"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periods Period[]
  classes Class[]
  feeSchedules FeeScheduleItem[]
  teacherAssignments TeacherAssignment[]
  enrollments  Enrollment[]
  timetableEntries TimetableEntry[]

  @@unique([tenantId, label])
  @@map("academic_years")
}

model Period {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  academicYearId  String       @map("academic_year_id") @db.Uuid
  kind            PeriodKind
  label           String       // "Trimestre 1", "Semestre 2"
  startDate       DateTime     @map("start_date") @db.Date
  endDate         DateTime     @map("end_date") @db.Date

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  evaluations  Evaluation[]

  @@index([tenantId, academicYearId])
  @@map("periods")
}

model Cycle {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   // "primaire", "college", "lycee", "licence", "master"
  label     String
  order     Int      @default(0)
  /// Réglages spécifiques au cycle (JSON). Overrides les défauts du tenant.
  /// Structure : { "timetable": TimetableSettings }
  /// Si absent ou champ manquant, hérite de Tenant.settings.timetable.
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levels Level[]
  teacherCycles TeacherCycle[]

  @@unique([tenantId, code])
  @@map("cycles")
}

model Level {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cycleId   String   @map("cycle_id") @db.Uuid
  code      String   // "cp", "ce1", "6eme", "l1", ...
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle             Cycle               @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  classes           Class[]
  feeSchedules      FeeScheduleItem[]
  curriculumSubjects CurriculumSubject[]
  enrollments       Enrollment[]

  @@unique([tenantId, code])
  @@map("levels")
}

/// Programme pédagogique : pour un niveau donné, la liste des matières
/// enseignées avec leur volume horaire hebdomadaire et leur coefficient.
/// Source de vérité pour le calcul des moyennes pondérées et la planification
/// des heures profs (TeacherAssignment).
model CurriculumSubject {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  levelId      String   @map("level_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  weeklyHours  Float    @map("weekly_hours")
  coefficient  Float    @default(1.0)
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([levelId, subjectId])
  @@index([tenantId, levelId])
  @@index([tenantId, subjectId])
  @@map("curriculum_subjects")
}

model Class {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  academicYearId  String    @map("academic_year_id") @db.Uuid
  levelId         String    @map("level_id") @db.Uuid
  name            String    // "1AC-A", "TD-Info-1"
  capacity        Int       @default(30)
  mainTeacherId   String?   @map("main_teacher_id") @db.Uuid
  /// Métadonnées de la classe, dont contraintes EDT (E2).
  /// Structure : { "timetableConstraints": ClassTimetableConstraints }
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level        Level               @relation(fields: [levelId], references: [id])
  mainTeacher  Person?             @relation("MainTeacher", fields: [mainTeacherId], references: [id])
  students     StudentClass[]
  attendanceSessions AttendanceSession[]
  evaluations  Evaluation[]
  teacherAssignments TeacherAssignment[]
  enrollments  Enrollment[]
  timetableEntries TimetableEntry[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId, levelId])
  @@map("classes")
}

model StudentClass {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  classId     String    @map("class_id") @db.Uuid
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  unenrolledAt DateTime? @map("unenrolled_at")

  student Person @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([tenantId, classId])
  @@map("student_classes")
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   // "A101", "Labo-Info-2"
  label     String
  capacity  Int      @default(0)
  equipment String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]
  substitutionsAsRoom TimetableOverride[] @relation("SubstituteRoom")

  @@unique([tenantId, code])
  @@map("rooms")
}

// ─── Audit & fichiers ──────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   // "create", "update", "delete", "login", ...
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model FileObject {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ownerType   String   @map("owner_type") // "person.contract", "bulletin", ...
  ownerId     String   @map("owner_id")
  s3Key       String   @unique @map("s3_key")
  filename    String
  mime        String
  sizeBytes   Int      @map("size_bytes")
  checksum    String?
  encrypted   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractOf Person? @relation("ContractFile")

  @@index([tenantId, ownerType, ownerId])
  @@map("files")
}

// ─── Présences (M05) ───────────────────────────────────────

/// Une session d'appel pour une classe à une date donnée, éventuellement
/// ventilée par période (créneau horaire ou matière). Unique par triplet
/// (classId, date, periodLabel) — `null` autorisé sur periodLabel pour les
/// appels journaliers globaux (primaire par ex).
model AttendanceSession {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  classId      String    @map("class_id") @db.Uuid
  date         DateTime  @db.Date
  periodLabel  String?   @map("period_label") // "08h00-09h00", "Cours 1", "Matin", ...
  finalizedAt  DateTime? @map("finalized_at") // null = brouillon, set = validé
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([classId, date, periodLabel])
  @@index([tenantId, date])
  @@map("attendance_sessions")
}

/// Statut d'un élève pour une session d'appel donnée. Default PRESENT —
/// au démarrage d'une nouvelle session, on insère une ligne par élève
/// inscrit (status PRESENT), et l'enseignant ne saisit que les exceptions.
model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  status       AttendanceStatus @default(PRESENT)
  lateMinutes  Int?             @map("late_minutes") // utilisé si status=LATE
  note         String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session      AttendanceSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student      Person                @relation("StudentAttendance", fields: [studentId], references: [id])
  justification AbsenceJustification?

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId])
  @@map("attendance_records")
}

/// Pointage journalier d'un membre du personnel (TEACHER ou STAFF).
/// Une seule ligne par (personId, date). deductionAmount est calculé au
/// moment de l'enregistrement à partir du salaire brut et du status, mais
/// reste stocké pour permettre des ajustements manuels (cas de force
/// majeure, conventions internes, etc.).
model StaffAttendance {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  personId         String                @map("person_id") @db.Uuid
  date             DateTime              @db.Date
  status           StaffAttendanceStatus @default(PRESENT)
  checkIn          DateTime?             @map("check_in")
  checkOut         DateTime?             @map("check_out")
  lateMinutes      Int?                  @map("late_minutes")
  /// Montant de la retenue salariale automatique (devise du tenant).
  /// 0 si PRESENT/EXCUSED/LEAVE. Calculé via computeStaffDeduction().
  deductionAmount  Decimal               @default(0) @map("deduction_amount") @db.Decimal(12, 2)
  /// Vrai si l'opérateur a verrouillé la valeur calculée pour ce jour.
  /// Permet de saisir un montant manuel sans qu'un recalcul ne l'écrase.
  deductionLocked  Boolean               @default(false) @map("deduction_locked")
  note             String?
  recordedByUserId String?               @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation("StaffAttendance", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, date])
  @@index([tenantId, date])
  @@index([tenantId, personId])
  @@map("staff_attendance")
}

/// Justification d'absence ou de retard. Workflow PENDING → APPROVED/REJECTED.
/// Une seule justification active par AttendanceRecord (1-1).
model AbsenceJustification {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  attendanceRecordId String              @unique @map("attendance_record_id") @db.Uuid
  reason             String
  submittedByUserId  String?             @map("submitted_by_user_id") @db.Uuid
  submittedAt        DateTime            @default(now()) @map("submitted_at")
  status             JustificationStatus @default(PENDING)
  reviewedByUserId   String?             @map("reviewed_by_user_id") @db.Uuid
  reviewedAt         DateTime?           @map("reviewed_at")
  reviewNote         String?             @map("review_note")
  attachmentUrl      String?             @map("attachment_url")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("absence_justifications")
}

// ─── Notes / Évaluations (M06) ─────────────────────────────

/// Matière enseignée (mathématiques, français, arabe, ...).
/// Le coefficient global de la matière s'applique lors du calcul de la
/// moyenne générale d'une période ; on garde la possibilité de coefficients
/// par filière pour la V1 via des configs séparées plus tard.
model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   // "math", "fr", "ar"
  label       String
  scale       Float    @default(20) // /20 par défaut (peut être 10, 100, etc.)
  coefficient Float    @default(1.0)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]
  teacherAssignments TeacherAssignment[]
  curriculumEntries CurriculumSubject[]
  teacherSpecialties TeacherSpecialty[]
  timetableEntries  TimetableEntry[]
  substitutionsAsSubject TimetableOverride[] @relation("SubstituteSubject")

  @@unique([tenantId, code])
  /// Empêche deux matières d'avoir le même libellé dans un même tenant —
  /// évite les "Mathématiques" en double qui rendaient les dropdowns ambigus.
  @@unique([tenantId, label])
  @@map("subjects")
}

/// Une évaluation d'une classe pour une matière à une date donnée.
/// Un Grade y est attaché par élève inscrit dans la classe.
model Evaluation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  periodId  String   @map("period_id") @db.Uuid
  label     String   // "Contrôle 1", "Examen mi-trimestre"
  date      DateTime @db.Date
  weight    Float    @default(1.0)  // pondération de cette évaluation au sein de la matière
  maxValue  Float    @default(20.0) @map("max_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period  Period  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  grades  Grade[]

  @@index([tenantId, classId, periodId, subjectId])
  @@map("evaluations")
}

/// Note d'un élève à une évaluation. value=null signifie "non noté" ou
/// "absent à l'épreuve" (distingué via la présence d'un AttendanceRecord
/// ce jour-là si besoin — phase 2).
model Grade {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  evaluationId String   @map("evaluation_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  value        Float?
  comment      String?
  enteredByUserId String? @map("entered_by_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  student    Person     @relation("StudentGrades", fields: [studentId], references: [id])

  @@unique([evaluationId, studentId])
  @@index([tenantId, studentId])
  @@map("grades")
}

/// Appréciation d'un élève pour une matière sur une période donnée.
/// Une seule appréciation par triplet (student, subject, period).
model SubjectAppreciation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  subjectId       String   @map("subject_id") @db.Uuid
  periodId        String   @map("period_id") @db.Uuid
  text            String
  authoredByUserId String? @map("authored_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Person @relation("StudentSubjectAppreciations", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, periodId])
  @@index([tenantId, periodId])
  @@map("subject_appreciations")
}

/// Décision du conseil de classe pour un élève sur une période.
/// Inclut l'appréciation générale et la décision (passage/redoublement/…).
/// 1 seule entrée par (student, class, period).
model CouncilEntry {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  classId            String           @map("class_id") @db.Uuid
  periodId           String           @map("period_id") @db.Uuid
  studentId          String           @map("student_id") @db.Uuid
  generalAppreciation String?         @map("general_appreciation")
  decision           CouncilDecision?
  heldAt             DateTime?        @map("held_at")
  authoredByUserId   String?          @map("authored_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Person @relation("StudentCouncil", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, periodId, studentId])
  @@index([tenantId, periodId])
  @@map("council_entries")
}

// ─── Inscriptions (M11) ────────────────────────────────────

/// Dossier d'inscription pour une année scolaire. Unique par
/// (studentId, academicYearId) : un élève ne peut pas avoir 2 dossiers
/// pour la même année. La transition DRAFT → ACTIVE génère le lien
/// StudentClass + les Installments depuis la grille FeeScheduleItem,
/// en appliquant la réduction fratrie si applicable.
model Enrollment {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  studentId           String           @map("student_id") @db.Uuid
  academicYearId      String           @map("academic_year_id") @db.Uuid
  levelId             String           @map("level_id") @db.Uuid
  classId             String?          @map("class_id") @db.Uuid
  status              EnrollmentStatus @default(DRAFT)
  /// Rang fratrie au moment de la validation (1 = aîné).
  /// Sert à appliquer la réduction `siblingDiscountPct` du tenant.
  siblingRank         Int?             @map("sibling_rank")
  /// Réduction effectivement appliquée en pourcentage (issue du tenant
  /// settings ou écrasée manuellement par l'agent).
  discountPct         Decimal?         @map("discount_pct") @db.Decimal(5, 2)
  discountReason      String?          @map("discount_reason")
  /// True une fois les Installments générés. Permet d'éviter une double
  /// génération si on repasse par validate().
  feesGenerated       Boolean          @default(false) @map("fees_generated")
  enrolledAt          DateTime         @default(now()) @map("enrolled_at")
  validatedAt         DateTime?        @map("validated_at")
  withdrawnAt         DateTime?        @map("withdrawn_at")
  withdrawalReason    String?          @map("withdrawal_reason")
  notes               String?
  createdByUserId     String?          @map("created_by_user_id") @db.Uuid
  validatedByUserId   String?          @map("validated_by_user_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Person       @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level        Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([studentId, academicYearId])
  @@index([tenantId, academicYearId, status])
  @@index([tenantId, classId])
  @@map("enrollments")
}

// ─── Emploi du temps (M12) ─────────────────────────────────

/// Créneau horaire de la grille de l'établissement (semaine type). Réutilisé
/// par toutes les classes : ex 08h00-09h00, 09h00-10h00, … et créneaux pause
/// (récré, cantine). Unique par (tenant × startTime × endTime).
model TimetableSlot {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Heure de début au format HH:MM (24h)
  startTime String   @map("start_time")
  /// Heure de fin au format HH:MM (24h)
  endTime   String   @map("end_time")
  /// Libellé optionnel (« Récréation », « Pause déjeuner »…). Si null,
  /// l'UI affiche juste l'intervalle horaire.
  label     String?
  /// True si pas de cours saisissable (pause/récré). Aucune TimetableEntry
  /// ne devrait pointer vers ce slot.
  isBreak   Boolean  @default(false) @map("is_break")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([tenantId, startTime, endTime])
  @@index([tenantId, order])
  @@map("timetable_slots")
}

/// Une case de l'emploi du temps : pour une (classe × jour × créneau) sur
/// une année scolaire, on a (matière × prof × salle). Unique sur
/// (classId × academicYearId × dayOfWeek × slotId).
///
/// Les conflits prof (même prof dans 2 classes au même créneau) et
/// salle (même salle dans 2 classes au même créneau) sont détectés au
/// vol côté serveur — pas de contrainte SQL pour permettre le rattrapage
/// (l'admin peut vouloir saisir un conflit puis le résoudre).
model TimetableEntry {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  academicYearId  String    @map("academic_year_id") @db.Uuid
  classId         String    @map("class_id") @db.Uuid
  slotId          String    @map("slot_id") @db.Uuid
  dayOfWeek       DayOfWeek @map("day_of_week")
  subjectId       String?   @map("subject_id") @db.Uuid
  teacherId       String?   @map("teacher_id") @db.Uuid
  roomId          String?   @map("room_id") @db.Uuid
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  slot         TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subject      Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher      Person?       @relation("TeacherTimetable", fields: [teacherId], references: [id], onDelete: SetNull)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  overrides    TimetableOverride[]

  @@unique([classId, academicYearId, dayOfWeek, slotId])
  @@index([tenantId, academicYearId, dayOfWeek, slotId])
  @@index([tenantId, teacherId])
  @@index([tenantId, roomId])
  @@map("timetable_entries")
}

/// Exception ponctuelle à une case d'EDT pour une date donnée. Permet
/// d'annuler un cours (jour férié, absence prof) ou de placer un remplaçant
/// (substitute teacher / changement de salle) sans toucher la semaine type.
///
/// Unique sur (entryId × date) : 1 override max par séance.
model TimetableOverride {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  entryId           String                @map("entry_id") @db.Uuid
  date              DateTime              @db.Date
  kind              TimetableOverrideKind
  substituteTeacherId String?             @map("substitute_teacher_id") @db.Uuid
  substituteRoomId    String?             @map("substitute_room_id") @db.Uuid
  substituteSubjectId String?             @map("substitute_subject_id") @db.Uuid
  reason            String?
  createdByUserId   String?               @map("created_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry             TimetableEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  substituteTeacher Person?        @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id], onDelete: SetNull)
  substituteRoom    Room?          @relation("SubstituteRoom", fields: [substituteRoomId], references: [id], onDelete: SetNull)
  substituteSubject Subject?       @relation("SubstituteSubject", fields: [substituteSubjectId], references: [id], onDelete: SetNull)

  @@unique([entryId, date])
  @@index([tenantId, date])
  @@map("timetable_overrides")
}

/// Contrainte paramétrable qui pilote le solveur d'EDT. Une ligne par
/// (tenant × kind) — activable/désactivable + config JSON par type.
model TimetableConstraint {
  id        String                  @id @default(uuid()) @db.Uuid
  tenantId  String                  @map("tenant_id") @db.Uuid
  kind      TimetableConstraintKind
  enabled   Boolean                 @default(true)
  config    Json                    @default("{}")
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind])
  @@map("timetable_constraints")
}

// ─── Communication (M09) ───────────────────────────────────

/// Annonce établissement, ciblée selon une audience.
/// publishedAt=null → brouillon. classId/levelId requis si audience=CLASS/LEVEL.
model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  authorId    String               @map("author_id") @db.Uuid
  title       String
  body        String
  audience    AnnouncementAudience
  classId     String?              @map("class_id") @db.Uuid
  levelId     String?              @map("level_id") @db.Uuid
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, publishedAt])
  @@map("announcements")
}

/// Conversation 1↔1 ou de groupe entre utilisateurs (parents, enseignants).
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  subject   String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([tenantId, updatedAt])
  @@map("conversations")
}

/// Participant à une conversation. lastReadAt sert au compteur de non-lus.
model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([tenantId, userId])
  @@map("conversation_participants")
}

/// Message dans une conversation.
model Message {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderUserId   String   @map("sender_user_id") @db.Uuid
  body           String
  sentAt         DateTime @default(now()) @map("sent_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

// ─── Finance (M10) ─────────────────────────────────────────

/// Grille tarifaire pour un niveau et une année scolaire.
/// installmentCount = nombre d'échéances mensuelles à générer.
model FeeScheduleItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  academicYearId  String   @map("academic_year_id") @db.Uuid
  levelId         String   @map("level_id") @db.Uuid
  label           String                                 // "Frais annuels", "Cantine", etc.
  totalAmount     Decimal  @db.Decimal(12, 2) @map("total_amount")
  installmentCount Int     @default(9) @map("installment_count")
  firstDueMonth   Int      @default(9) @map("first_due_month")  // 9 = sept
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level        Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, academicYearId, levelId, label])
  @@map("fee_schedules")
}

/// Échéance due pour un élève. Générée à la volée depuis une FeeScheduleItem.
/// status calculé : sumPayments == 0 → PENDING, < amount → PARTIAL, ≥ → PAID.
model Installment {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  studentId     String            @map("student_id") @db.Uuid
  feeScheduleItemId String?       @map("fee_schedule_item_id") @db.Uuid  // null si ad hoc
  label         String                                  // "Mensualité septembre"
  amount        Decimal           @db.Decimal(12, 2)
  dueDate       DateTime          @db.Date              @map("due_date")
  status        InstallmentStatus @default(PENDING)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Person    @relation("StudentInstallments", fields: [studentId], references: [id])
  payments Payment[]

  @@index([tenantId, studentId, status])
  @@index([tenantId, dueDate])
  @@map("installments")
}

/// Paiement enregistré sur une échéance. Plusieurs paiements possibles
/// (paiement partiel). status de l'échéance recalculé après chaque insert.
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  installmentId String        @map("installment_id") @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?       // numéro chèque, ref virement, txn CMI, etc.
  paidAt        DateTime      @default(now()) @map("paid_at")
  recordedByUserId String?    @map("recorded_by_user_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@map("payments")
}
