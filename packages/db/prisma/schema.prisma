// ───────────────────────────────────────────────────────────
// Jawal — Schéma Prisma initial (Module Core)
// Multi-tenant : toutes les tables métier portent tenant_id
// Isolation : Row-Level Security PostgreSQL (voir migration init)
// ───────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

// ─── Énumérations ──────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  ARCHIVED
}

enum TenantProfile {
  K12              // Primaire/secondaire
  SUPERIEUR        // Enseignement supérieur
  FORMATION_PRO    // Formation professionnelle
  MIXED            // Établissement multi-segments
}

enum PersonType {
  STUDENT
  PARENT
  TEACHER
  STAFF
}

enum Gender {
  M
  F
  X
}

enum PeriodKind {
  TRIMESTER
  SEMESTER
  YEAR
  MODULE
  SESSION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED // dispense, sortie anticipée, retrait justifié
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstallmentStatus {
  PENDING    // due, non payé
  PARTIAL    // partiellement payé
  PAID       // intégralement payé
  CANCELLED  // annulé (ex: élève parti)
}

enum PaymentMethod {
  CASH       // espèces (caisse)
  CHEQUE
  TRANSFER   // virement
  CMI        // CMI sandbox/prod
  STRIPE
  OTHER
}

enum AnnouncementAudience {
  ALL              // tout l'établissement
  PARENTS          // tous les parents
  TEACHERS         // tous les enseignants
  STAFF            // personnel
  CLASS            // une classe spécifique (classId requis)
  LEVEL            // un niveau (levelId requis)
}

enum CouncilDecision {
  FELICITATIONS         // Mention spéciale pour excellents résultats
  ENCOURAGEMENTS        // Encouragements pour effort
  COMPLIMENTS           // Compliments simples
  AVERTISSEMENT_TRAVAIL // Avertissement travail insuffisant
  AVERTISSEMENT_COMP    // Avertissement comportement
  PASSAGE               // Passage en classe supérieure
  REDOUBLEMENT          // Redoublement
  ORIENTATION           // Réorientation conseillée
}

// ─── Tenants & modules ─────────────────────────────────────

model Tenant {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  name          String
  customDomain  String?       @unique @map("custom_domain")
  profile       TenantProfile @default(K12)
  status        TenantStatus  @default(TRIAL)
  localeDefault String        @default("fr") @map("locale_default")
  timezone      String        @default("Africa/Casablanca")
  currency      String        @default("MAD")
  settings      Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  modules        TenantModule[]
  users          User[]
  persons        Person[]
  roles          Role[]
  academicYears  AcademicYear[]
  cycles         Cycle[]
  levels         Level[]
  classes        Class[]
  rooms          Room[]
  periods        Period[]
  auditLogs      AuditLog[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  absenceJustifications AbsenceJustification[]
  subjects       Subject[]
  evaluations    Evaluation[]
  grades         Grade[]
  subjectAppreciations SubjectAppreciation[]
  councilEntries CouncilEntry[]
  announcements  Announcement[]
  conversations  Conversation[]
  messages       Message[]
  conversationParticipants ConversationParticipant[]
  feeSchedules   FeeScheduleItem[]
  installments   Installment[]
  payments       Payment[]
  files          FileObject[]

  @@map("tenants")
}

model TenantModule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   // ex: "core", "admissions", "notes"
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("tenant_modules")
}

// ─── Auth & identités ──────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  email         String    @db.Citext
  passwordHash  String?   @map("password_hash")
  emailVerified DateTime? @map("email_verified")
  mfaSecret     String?   @map("mfa_secret")
  /// Super-admin SaaS — bypasse l'isolation tenant (gère tous les tenants).
  /// Reste rattaché à un tenant pour les contraintes de schéma mais ses
  /// opérations utilisent le client `prismaAdmin` (superuser PostgreSQL).
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  locale        String    @default("fr")
  lastLoginAt   DateTime? @map("last_login_at")
  disabledAt    DateTime? @map("disabled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  userPersons UserPerson[]
  auditLogs   AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Person {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  type        PersonType
  firstName   String     @map("first_name")
  lastName    String     @map("last_name")
  birthDate   DateTime?  @map("birth_date") @db.Date
  gender      Gender?
  nationality String?
  cin         String?    // CIN / passeport
  contacts    Json       @default("{}") // { email, phone, ... }
  address     Json       @default("{}")
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userPersons        UserPerson[]
  studentClasses     StudentClass[]
  mainOfClass        Class[]            @relation("MainTeacher")
  attendanceRecords  AttendanceRecord[] @relation("StudentAttendance")
  grades             Grade[]            @relation("StudentGrades")
  subjectAppreciations SubjectAppreciation[] @relation("StudentSubjectAppreciations")
  councilEntries     CouncilEntry[]     @relation("StudentCouncil")
  installments       Installment[]      @relation("StudentInstallments")

  @@index([tenantId, type])
  @@index([tenantId, lastName, firstName])
  @@map("persons")
}

/// Lien compte ↔ identité (un user peut représenter plusieurs persons,
/// ex. parent rattaché à plusieurs enfants).
model UserPerson {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  relationship String?   // self, father, mother, guardian, ...
  createdAt    DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([userId, personId])
  @@index([tenantId])
  @@map("user_persons")
}

// ─── RBAC ──────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   // tenant_admin, direction, scolarite, enseignant, parent, eleve, ...
  label       String
  permissions String[] // ex: ["notes.write", "bulletins.publish"]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  /// Restriction du rôle à un périmètre (ex: { "classes": ["uuid1", "uuid2"] })
  scope     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

// ─── Structure pédagogique ─────────────────────────────────

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  label     String   // "2025-2026"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periods Period[]
  classes Class[]
  feeSchedules FeeScheduleItem[]

  @@unique([tenantId, label])
  @@map("academic_years")
}

model Period {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  academicYearId  String       @map("academic_year_id") @db.Uuid
  kind            PeriodKind
  label           String       // "Trimestre 1", "Semestre 2"
  startDate       DateTime     @map("start_date") @db.Date
  endDate         DateTime     @map("end_date") @db.Date

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  evaluations  Evaluation[]

  @@index([tenantId, academicYearId])
  @@map("periods")
}

model Cycle {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   // "primaire", "college", "lycee", "licence", "master"
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levels Level[]

  @@unique([tenantId, code])
  @@map("cycles")
}

model Level {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cycleId   String   @map("cycle_id") @db.Uuid
  code      String   // "cp", "ce1", "6eme", "l1", ...
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle        Cycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  classes      Class[]
  feeSchedules FeeScheduleItem[]

  @@unique([tenantId, code])
  @@map("levels")
}

model Class {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  academicYearId  String    @map("academic_year_id") @db.Uuid
  levelId         String    @map("level_id") @db.Uuid
  name            String    // "1AC-A", "TD-Info-1"
  capacity        Int       @default(30)
  mainTeacherId   String?   @map("main_teacher_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level        Level               @relation(fields: [levelId], references: [id])
  mainTeacher  Person?             @relation("MainTeacher", fields: [mainTeacherId], references: [id])
  students     StudentClass[]
  attendanceSessions AttendanceSession[]
  evaluations  Evaluation[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId, levelId])
  @@map("classes")
}

model StudentClass {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  classId     String    @map("class_id") @db.Uuid
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  unenrolledAt DateTime? @map("unenrolled_at")

  student Person @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([tenantId, classId])
  @@map("student_classes")
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   // "A101", "Labo-Info-2"
  label     String
  capacity  Int      @default(0)
  equipment String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("rooms")
}

// ─── Audit & fichiers ──────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   // "create", "update", "delete", "login", ...
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model FileObject {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ownerType   String   @map("owner_type") // "student", "tenant", "bulletin", ...
  ownerId     String   @map("owner_id")
  s3Key       String   @unique @map("s3_key")
  filename    String
  mime        String
  sizeBytes   Int      @map("size_bytes")
  checksum    String?
  encrypted   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerType, ownerId])
  @@map("files")
}

// ─── Présences (M05) ───────────────────────────────────────

/// Une session d'appel pour une classe à une date donnée, éventuellement
/// ventilée par période (créneau horaire ou matière). Unique par triplet
/// (classId, date, periodLabel) — `null` autorisé sur periodLabel pour les
/// appels journaliers globaux (primaire par ex).
model AttendanceSession {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  classId      String    @map("class_id") @db.Uuid
  date         DateTime  @db.Date
  periodLabel  String?   @map("period_label") // "08h00-09h00", "Cours 1", "Matin", ...
  finalizedAt  DateTime? @map("finalized_at") // null = brouillon, set = validé
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([classId, date, periodLabel])
  @@index([tenantId, date])
  @@map("attendance_sessions")
}

/// Statut d'un élève pour une session d'appel donnée. Default PRESENT —
/// au démarrage d'une nouvelle session, on insère une ligne par élève
/// inscrit (status PRESENT), et l'enseignant ne saisit que les exceptions.
model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  status       AttendanceStatus @default(PRESENT)
  lateMinutes  Int?             @map("late_minutes") // utilisé si status=LATE
  note         String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session      AttendanceSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student      Person                @relation("StudentAttendance", fields: [studentId], references: [id])
  justification AbsenceJustification?

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId])
  @@map("attendance_records")
}

/// Justification d'absence ou de retard. Workflow PENDING → APPROVED/REJECTED.
/// Une seule justification active par AttendanceRecord (1-1).
model AbsenceJustification {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  attendanceRecordId String              @unique @map("attendance_record_id") @db.Uuid
  reason             String
  submittedByUserId  String?             @map("submitted_by_user_id") @db.Uuid
  submittedAt        DateTime            @default(now()) @map("submitted_at")
  status             JustificationStatus @default(PENDING)
  reviewedByUserId   String?             @map("reviewed_by_user_id") @db.Uuid
  reviewedAt         DateTime?           @map("reviewed_at")
  reviewNote         String?             @map("review_note")
  attachmentUrl      String?             @map("attachment_url")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("absence_justifications")
}

// ─── Notes / Évaluations (M06) ─────────────────────────────

/// Matière enseignée (mathématiques, français, arabe, ...).
/// Le coefficient global de la matière s'applique lors du calcul de la
/// moyenne générale d'une période ; on garde la possibilité de coefficients
/// par filière pour la V1 via des configs séparées plus tard.
model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   // "math", "fr", "ar"
  label       String
  scale       Float    @default(20) // /20 par défaut (peut être 10, 100, etc.)
  coefficient Float    @default(1.0)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]

  @@unique([tenantId, code])
  @@map("subjects")
}

/// Une évaluation d'une classe pour une matière à une date donnée.
/// Un Grade y est attaché par élève inscrit dans la classe.
model Evaluation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  periodId  String   @map("period_id") @db.Uuid
  label     String   // "Contrôle 1", "Examen mi-trimestre"
  date      DateTime @db.Date
  weight    Float    @default(1.0)  // pondération de cette évaluation au sein de la matière
  maxValue  Float    @default(20.0) @map("max_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period  Period  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  grades  Grade[]

  @@index([tenantId, classId, periodId, subjectId])
  @@map("evaluations")
}

/// Note d'un élève à une évaluation. value=null signifie "non noté" ou
/// "absent à l'épreuve" (distingué via la présence d'un AttendanceRecord
/// ce jour-là si besoin — phase 2).
model Grade {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  evaluationId String   @map("evaluation_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  value        Float?
  comment      String?
  enteredByUserId String? @map("entered_by_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  student    Person     @relation("StudentGrades", fields: [studentId], references: [id])

  @@unique([evaluationId, studentId])
  @@index([tenantId, studentId])
  @@map("grades")
}

/// Appréciation d'un élève pour une matière sur une période donnée.
/// Une seule appréciation par triplet (student, subject, period).
model SubjectAppreciation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  subjectId       String   @map("subject_id") @db.Uuid
  periodId        String   @map("period_id") @db.Uuid
  text            String
  authoredByUserId String? @map("authored_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Person @relation("StudentSubjectAppreciations", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, periodId])
  @@index([tenantId, periodId])
  @@map("subject_appreciations")
}

/// Décision du conseil de classe pour un élève sur une période.
/// Inclut l'appréciation générale et la décision (passage/redoublement/…).
/// 1 seule entrée par (student, class, period).
model CouncilEntry {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  classId            String           @map("class_id") @db.Uuid
  periodId           String           @map("period_id") @db.Uuid
  studentId          String           @map("student_id") @db.Uuid
  generalAppreciation String?         @map("general_appreciation")
  decision           CouncilDecision?
  heldAt             DateTime?        @map("held_at")
  authoredByUserId   String?          @map("authored_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Person @relation("StudentCouncil", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, periodId, studentId])
  @@index([tenantId, periodId])
  @@map("council_entries")
}

// ─── Communication (M09) ───────────────────────────────────

/// Annonce établissement, ciblée selon une audience.
/// publishedAt=null → brouillon. classId/levelId requis si audience=CLASS/LEVEL.
model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  authorId    String               @map("author_id") @db.Uuid
  title       String
  body        String
  audience    AnnouncementAudience
  classId     String?              @map("class_id") @db.Uuid
  levelId     String?              @map("level_id") @db.Uuid
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, publishedAt])
  @@map("announcements")
}

/// Conversation 1↔1 ou de groupe entre utilisateurs (parents, enseignants).
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  subject   String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([tenantId, updatedAt])
  @@map("conversations")
}

/// Participant à une conversation. lastReadAt sert au compteur de non-lus.
model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([tenantId, userId])
  @@map("conversation_participants")
}

/// Message dans une conversation.
model Message {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderUserId   String   @map("sender_user_id") @db.Uuid
  body           String
  sentAt         DateTime @default(now()) @map("sent_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

// ─── Finance (M10) ─────────────────────────────────────────

/// Grille tarifaire pour un niveau et une année scolaire.
/// installmentCount = nombre d'échéances mensuelles à générer.
model FeeScheduleItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  academicYearId  String   @map("academic_year_id") @db.Uuid
  levelId         String   @map("level_id") @db.Uuid
  label           String                                 // "Frais annuels", "Cantine", etc.
  totalAmount     Decimal  @db.Decimal(12, 2) @map("total_amount")
  installmentCount Int     @default(9) @map("installment_count")
  firstDueMonth   Int      @default(9) @map("first_due_month")  // 9 = sept
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level        Level        @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, academicYearId, levelId, label])
  @@map("fee_schedules")
}

/// Échéance due pour un élève. Générée à la volée depuis une FeeScheduleItem.
/// status calculé : sumPayments == 0 → PENDING, < amount → PARTIAL, ≥ → PAID.
model Installment {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  studentId     String            @map("student_id") @db.Uuid
  feeScheduleItemId String?       @map("fee_schedule_item_id") @db.Uuid  // null si ad hoc
  label         String                                  // "Mensualité septembre"
  amount        Decimal           @db.Decimal(12, 2)
  dueDate       DateTime          @db.Date              @map("due_date")
  status        InstallmentStatus @default(PENDING)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Person    @relation("StudentInstallments", fields: [studentId], references: [id])
  payments Payment[]

  @@index([tenantId, studentId, status])
  @@index([tenantId, dueDate])
  @@map("installments")
}

/// Paiement enregistré sur une échéance. Plusieurs paiements possibles
/// (paiement partiel). status de l'échéance recalculé après chaque insert.
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  installmentId String        @map("installment_id") @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?       // numéro chèque, ref virement, txn CMI, etc.
  paidAt        DateTime      @default(now()) @map("paid_at")
  recordedByUserId String?    @map("recorded_by_user_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, paidAt])
  @@map("payments")
}
