  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  evaluations  Evaluation[]
  examSessions ExamSession[]

  @@index([tenantId, academicYearId])
  @@map("periods")
}

model Cycle {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String // "primaire", "college", "lycee", "licence", "master"
  label     String
  /// Libellé arabe du cycle (ex. « التعليم الإعدادي »).
  labelAr   String?  @map("label_ar")
  order     Int      @default(0)
  /// Réglages spécifiques au cycle (JSON). Overrides les défauts du tenant.
  /// Structure : { "timetable": TimetableSettings }
