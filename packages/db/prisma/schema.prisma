enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED // dispense, sortie anticipée, retrait justifié
}

/// Mode d'un devoir facultatif (cf. Evaluation.optionalMode).
enum EvaluationOptionalMode {
  BONUS // points au-dessus de 10/20 ajoutés directement à la moyenne
  NOTE // comptée seulement si elle améliore la moyenne
}

/// Catégorie d'un événement de vie scolaire (module Gestion des absences).
enum AttendanceEventCategory {
  ABSENCE
  RETARD
  EXCLUSION
}

/// Statut de traitement par la Vie Scolaire d'un événement d'absence.
enum AttendanceEventStatus {
  PENDING // signalé par le prof, à traiter
  CONFIRMED // confirmé officiel (→ carnet + notif)
  JUSTIFIED // justifié
  CANCELLED // annulé (erreur de saisie côté prof)
}

/// Statut de pointage du personnel (enseignants ou administratif).
/// EXCUSED couvre congés, maladies, formations — sans retenue. ABSENT non
/// excusé déclenche une retenue calculée pro-rata sur le salaire mensuel.
enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  LEAVE // Congé / RTT planifié
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstallmentStatus {
  PENDING // due, non payé
  PARTIAL // partiellement payé
  PAID // intégralement payé
  CANCELLED // annulé (ex: élève parti)
}

/// Cycle de vie d'une inscription. DRAFT = préinscription en attente de
/// validation. ACTIVE = élève inscrit (StudentClass + échéancier générés).
/// WITHDRAWN = retrait en cours d'année. GRADUATED = clôture par succès.
enum EnrollmentStatus {
  DRAFT // = EN_ATTENTE (dossier créé, aucune pièce)
  DOCUMENTS_MANQUANTS // pièces incomplètes/invalides (auto)
  DOSSIER_COMPLET // toutes pièces présentes et conformes (auto)
  ACCEPTE // validé par l'administration, paiement non encore effectué
  REFUSE // rejeté (non-conformité, manque de place…) — motif requis
  INSCRIPTION_VALIDEE // frais d'inscription encaissés (auto via finance)
  AFFECTE // classe/niveau attribués → visible Vie scolaire
  ACTIVE // = ACTIF (intégré : classe, EDT, comptes activés)
  WITHDRAWN // = ARCHIVE (départ/transfert)
  GRADUATED // fin de cursus
}

/// Statut d'une pièce justificative déposée pour un dossier d'inscription.
enum DocumentStatus {
  PENDING // déposée, en attente de vérification
  VALID // vérifiée et conforme
  INVALID // refusée (illisible, non conforme…)
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

/// Type d'exception ponctuelle sur une case d'EDT pour une date précise.
///  - CANCELLED : le cours n'a pas lieu ce jour-là
///  - SUBSTITUTION : remplaçant (teacher) ou changement de salle (room) ou
///    de matière, le reste de la semaine type reste inchangé
enum TimetableOverrideKind {
  CANCELLED
  SUBSTITUTION
}

/// Circuit d'approbation d'un remplacement : la vie scolaire valide (soumet),
/// puis la direction/admin approuve ou refuse. Messages envoyés seulement si
/// APPROVED.
enum SubstitutionApproval {
  PENDING
  APPROVED
  REFUSED
}

/// Types de contraintes paramétrables qui pilotent le solveur d'EDT.
///
/// MAX_SAME_SUBJECT_PER_DAY (hard)
///   config: { max: int } — applique à toutes les classes : max N heures
///   d'une même matière sur la même journée pour la même classe.
///   Évite « 2× Maths le lundi ».
///
/// NO_GAPS (soft, poids élevé)
///   config: { weight: int } — pénalise tout pattern « cours … vide … cours »
///   dans la journée d'une classe. Réduit les heures creuses.
///
/// REQUIRES_CONSECUTIVE_SUBJECTS (hard)
///   config: { subjectIds: string[] } — pour ces matières, si weekly_hours
///   ≥ 2, force les séances à être consécutives par paires (blocs 2h).
///
/// MAX_HOURS_PER_DAY_TEACHER (hard)
///   config: { max: int } — chaque prof a au plus N heures de cours par jour.
///
/// MAX_CONSECUTIVE_HOURS_TEACHER (hard, phase 4E3)
///   config: { max: int } — chaque prof a au plus N heures de cours d'affilée
///   (au-delà, une pause est imposée dans la journée).
///
/// TEACHER_LUNCH_BREAK (hard, phase 4E3)
///   config: { from: "HH:MM", to: "HH:MM" } — chaque prof garde au moins un
///   créneau libre dans la plage déjeuner les jours où il enseigne (déjeuner
///   échelonné, sans bloquer la plage pour tout le monde).
///
/// REQUIRE_SUBJECT_ROOM_TYPE (hard, phase 4E4)
///   config: {} — les matières nécessitant un type de salle spécifique
///   (PC/SVT/Info/EPS, déduit par heuristique) ne sont placées que dans une
///   salle compatible. Sinon le cours reste non placé (diagnostic dédié).
///
/// MINIMIZE_ROOM_CHANGES (soft, phase 4E5)
///   config: { weight: int } — récompense le maintien de la même salle d'un
///   créneau au suivant pour une classe (moins de déménagements).
///
/// BALANCE_DAILY_LOAD (soft, phase 4E5)
///   config: { weight: int } — pénalise la journée la plus chargée de chaque
///   classe (répartit les heures, évite les journées trop longues).
enum TimetableConstraintKind {
  MAX_SAME_SUBJECT_PER_DAY
  NO_GAPS
  REQUIRES_CONSECUTIVE_SUBJECTS
  MAX_HOURS_PER_DAY_TEACHER
  MAX_CONSECUTIVE_HOURS_TEACHER
  TEACHER_LUNCH_BREAK
  REQUIRE_SUBJECT_ROOM_TYPE
  MINIMIZE_ROOM_CHANGES
  BALANCE_DAILY_LOAD
}

enum PaymentMethod {
  CASH // espèces (caisse)
  CHEQUE
  TRANSFER // virement
  CMI // CMI sandbox/prod
  STRIPE
  OTHER
}

enum AnnouncementAudience {
  ALL // tout l'établissement
  PARENTS // tous les parents
  TEACHERS // tous les enseignants
  STAFF // personnel
  CLASS // une classe spécifique (classId requis)
  LEVEL // un niveau (levelId requis)
}

enum CouncilDecision {
  FELICITATIONS // Mention spéciale pour excellents résultats
  ENCOURAGEMENTS // Encouragements pour effort
  COMPLIMENTS // Compliments simples
  AVERTISSEMENT_TRAVAIL // Avertissement travail insuffisant
  AVERTISSEMENT_COMP // Avertissement comportement
  PASSAGE // Passage en classe supérieure
  REDOUBLEMENT // Redoublement
  ORIENTATION // Réorientation conseillée
}

enum HomeworkType {
  EXERCICE
  LECTURE
  REVISION
  PROJET
  AUTRE
}

enum ResourceKind {
  FILE
  LINK
}

enum HomeworkDifficulty {
  FACILE
  MOYEN
  DIFFICILE
}

enum SurveyAudience {
  ALL
  PARENTS
  TEACHERS
  STAFF
  STUDENTS
}

enum SurveyStatus {
  DRAFT // en préparation, non diffusée
  OPEN // ouverte aux réponses
  CLOSED // clôturée (résultats figés)
}

enum SurveyQuestionType {
  RATING_5 // note 1 à 5 (alimente le KPI satisfaction)
  TEXT // réponse libre
}

// ─── Tenants & modules ─────────────────────────────────────

/// Groupe scolaire (propriétaire multi-établissements). Un Tenant peut être
/// rattaché à un groupe ; un compte de groupe accède à plusieurs tenants via
/// UserTenant. Hors RLS tenant (géré par le super-admin / prismaAdmin).
model TenantGroup {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("tenant_groups")
}

model Tenant {
  supportSessionSkills  SupportSessionSkill[]
  competencyReports     CompetencyReport[]
  competencyFrameworks  CompetencyFramework[]
  competencyNodes       CompetencyNode[]
  competencyNodeLevels  CompetencyNodeLevel[]
  masteryLevels         MasteryLevel[]
  competencyAssessments CompetencyAssessment[]
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  name          String
  /// Nom de l'établissement en arabe (en-têtes de documents, portail AR).
  nameAr        String?       @map("name_ar")
  /// Groupe scolaire de rattachement (null = établissement autonome).
  groupId       String?       @map("group_id") @db.Uuid
  customDomain  String?       @unique @map("custom_domain")
  /// Code établissement MASSAR (ex. « CASA001 »). Sert à filtrer les lignes
  /// d'un export MASSAR multi-établissements à l'import.
  massarCode    String?       @unique @map("massar_code")
  profile       TenantProfile @default(K12)
  status        TenantStatus  @default(TRIAL)
  localeDefault String        @default("fr") @map("locale_default")
  timezone      String        @default("Africa/Casablanca")
  currency      String        @default("MAD")
  /// Logo de l'établissement — FileObject (MinIO). Affiché dans les portails.
  logoFileId    String?       @unique @map("logo_file_id") @db.Uuid
  settings      Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  group                       TenantGroup?                 @relation(fields: [groupId], references: [id], onDelete: SetNull)
  userTenants                 UserTenant[]
  modules                     TenantModule[]
  users                       User[]
  persons                     Person[]
  roles                       Role[]
  academicYears               AcademicYear[]
  cycles                      Cycle[]
  levels                      Level[]
  classes                     Class[]
  rooms                       Room[]
  periods                     Period[]
  auditLogs                   AuditLog[]
  attendanceSessions          AttendanceSession[]
  attendanceRecords           AttendanceRecord[]
  attendanceReasons           AttendanceReason[]
  staffAbsenceReasons         StaffAbsenceReason[]
  attendanceEvents            AttendanceEvent[]
  carnetEntries               CarnetEntry[]
  absenceJustifications       AbsenceJustification[]
  subjects                    Subject[]
  evaluations                 Evaluation[]
  grades                      Grade[]
  subjectAppreciations        SubjectAppreciation[]
  councilEntries              CouncilEntry[]
  announcements               Announcement[]
  conversations               Conversation[]
  messages                    Message[]
  conversationParticipants    ConversationParticipant[]
  feeSchedules                FeeScheduleItem[]
  discountRules               DiscountRule[]
  appelReminders              AppelReminder[]
  installments                Installment[]
  payments                    Payment[]
  files                       FileObject[]
  personRoles                 PersonRole[]
  services                    Service[]
  personRelations             PersonRelation[]
  teacherAssignments          TeacherAssignment[]
  curriculumSubjects          CurriculumSubject[]
  teacherSpecialties          TeacherSpecialty[]
  teacherCycles               TeacherCycle[]
  teacherPriorityClasses      TeacherPriorityClass[]
  diplomas                    Diploma[]
  staffAttendance             StaffAttendance[]
  enrollments                 Enrollment[]
  admissionQuotas             AdmissionQuota[]
  requiredDocuments           RequiredDocument[]
  enrollmentDocuments         EnrollmentDocument[]
  timetableSlots              TimetableSlot[]
  classGroups                 ClassGroup[]
  classGroupMembers           ClassGroupMember[]
  timetableEntries            TimetableEntry[]
  timetableOverrides          TimetableOverride[]
  timetableConstraints        TimetableConstraint[]
  surveys                     Survey[]
  surveyQuestions             SurveyQuestion[]
  surveyResponses             SurveyResponse[]
  surveyAnswers               SurveyAnswer[]
  lessonEntries               LessonEntry[]
  homeworks                   Homework[]
  lessonResources             LessonResource[]
  exceptionalFeeTypes         ExceptionalFeeType[]
  exceptionalFees             ExceptionalFee[]
  exceptionalFeeAssignments   ExceptionalFeeAssignment[]
  expenses                    Expense[]
  paymentReminders            PaymentReminder[]
  transportZones              TransportZone[]
  buses                       Bus[]
  transportLines              TransportLine[]
  transportStops              TransportStop[]
  studentTransports           StudentTransport[]
  transportAttendanceSessions TransportAttendanceSession[]
  transportAttendanceRecords  TransportAttendanceRecord[]
  notificationLogs            NotificationLog[]
  leaveTypes                  LeaveType[]
  leaveRequests               LeaveRequest[]
  overtimeEntries             OvertimeEntry[]
  payrollConfigs              PayrollConfig[]
  employeePayrollProfiles     EmployeePayrollProfile[]
  payrollRuns                 PayrollRun[]
  payslips                    Payslip[]
  bookExchangeConfig          BookExchangeConfig?
  bookCampaigns               BookExchangeCampaign[]
  books                       Book[]
  bookCopies                  BookCopy[]
  bookTransactions            BookTransaction[]
  fiscalYears                 FiscalYear[]
  accounts                    Account[]
  journalEntries              JournalEntry[]
  journalLines                JournalLine[]
  suppliers                   Supplier[]
  supplierInvoices            SupplierInvoice[]
  supplierPayments            SupplierPayment[]
  radiationRequests           RadiationRequest[]
  radiationRefunds            RadiationRefund[]
  staffAlerts                 StaffAlert[]
  tracks                      Track[]
  trackSubjectCoefficients    TrackSubjectCoefficient[]
  gradingRules                GradingRule[]
  examSessions                ExamSession[]
  examSessionTracks           ExamSessionTrack[]
  examPapers                  ExamPaper[]
  examRoomAllocations         ExamRoomAllocation[]
  examSupervisors             ExamSupervisor[]
  examSeats                   ExamSeat[]
  examGraders                 ExamGrader[]
  examMarks                   ExamMark[]
  examBlueprints              ExamBlueprint[]
  examPaperTracks             ExamPaperTrack[]

  @@map("tenants")
}

model TenantModule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String // ex: "core", "admissions", "notes"
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("tenant_modules")
}

// ─── Auth & identités ──────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  email         String    @db.Citext
  passwordHash  String?   @map("password_hash")
  emailVerified DateTime? @map("email_verified")
  mfaSecret     String?   @map("mfa_secret")
  /// Super-admin SaaS — bypasse l'isolation tenant (gère tous les tenants).
  /// Reste rattaché à un tenant pour les contraintes de schéma mais ses
  /// opérations utilisent le client `prismaAdmin` (superuser PostgreSQL).
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  locale        String    @default("fr")
  lastLoginAt   DateTime? @map("last_login_at")
  disabledAt    DateTime? @map("disabled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles           UserRole[]
  userPersons         UserPerson[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  userTenants         UserTenant[]
  staffAlerts         StaffAlert[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Accès d'un compte à un établissement (multi-sites). Le tenant « home » reste
/// `User.tenantId` ; chaque UserTenant ajoute un site accessible. Les rôles par
/// site restent gérés par UserRole. Hors RLS tenant (lu via prismaAdmin au login).
model UserTenant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenants")
}

/// Régime de l'élève (restauration / hébergement). Null pour non-élèves.
enum StudentRegime {
  EXTERNE // externe (ne déjeune pas sur place)
  DEMI_PENSIONNAIRE // demi-pensionnaire (déjeune à la cantine)
  INTERNE // interne (hébergé)
}

/// Statut d'emploi d'un enseignant ou d'un membre du personnel.
enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  RESIGNED
  CONTRACT_END
}

model Person {
  competencyReports CompetencyReport[] @relation("StudentCompetencyReports")
  competencyAssessments CompetencyAssessment[] @relation("StudentCompetencyAssessments")
  id                      String                @id @default(uuid()) @db.Uuid
  tenantId                String                @map("tenant_id") @db.Uuid
  type                    PersonType
  /// Catégorie paramétrable (TEACHER ou STAFF uniquement). Null sinon.
  roleId                  String?               @map("role_id") @db.Uuid
  /// @deprecated Ancien service figé (enum). Remplacé par serviceId → Service.
  /// Conservé en transition ; ne plus écrire dessus.
  service                 StaffService?
  /// Service / département paramétrable de rattachement. Déduit du type/rôle.
  serviceId               String?               @map("service_id") @db.Uuid
  firstName               String                @map("first_name")
  lastName                String                @map("last_name")
  /// Nom et prénom en arabe (import MASSAR, documents et bulletins en AR).
  firstNameAr             String?               @map("first_name_ar")
  lastNameAr              String?               @map("last_name_ar")
  /// Identifiant élève MASSAR (code massar). Sert de clé de rapprochement
  /// pour rendre les imports rejouables sans créer de doublons.
  massarId                String?               @map("massar_id")
  birthDate               DateTime?             @map("birth_date") @db.Date
  /// Lieu de naissance, dans les deux langues (état civil marocain bilingue).
  birthPlace              String?               @map("birth_place")
  birthPlaceAr            String?               @map("birth_place_ar")
  gender                  Gender?
  nationality             String?
  nationalityAr           String?               @map("nationality_ar")
  /// Adresse en arabe — colonnes dédiées (la version française reste dans le
  /// JSON `address`), pour être requêtables comme le reste de l'état civil.
  addressAr               String?               @map("address_ar")
  cityAr                  String?               @map("city_ar")
  /// Prénoms des parents en arabe, portés par l'élève (les exports MASSAR ne
  /// fournissent que le prénom, sans fiche parent distincte).
  fatherFirstNameAr       String?               @map("father_first_name_ar")
  motherFirstNameAr       String?               @map("mother_first_name_ar")
  cin                     String? // CIN / passeport
  /// Régime de l'élève (externe / demi-pensionnaire / interne). Null sinon.
  regime                  StudentRegime?
  /// L'élève utilise-t-il le transport scolaire ? (pilote le frais Transport.)
  usesTransport           Boolean               @default(false) @map("uses_transport")
  contacts                Json                  @default("{}") // { email, phone, ... }
  address                 Json                  @default("{}")
  metadata                Json                  @default("{}")
  /// Date d'entrée en fonction (TEACHER/STAFF). Null pour STUDENT/PARENT.
  hireDate                DateTime?             @map("hire_date") @db.Date
  /// Date de sortie / fin de contrat. Null = encore en poste.
  contractEndDate         DateTime?             @map("contract_end_date") @db.Date
  contractType            ContractType?         @map("contract_type")
  /// Statut d'emploi (TEACHER/STAFF) : ACTIVE, SUSPENDED, RESIGNED, CONTRACT_END.
  /// Colonne dédiée — la liste Enseignants s'y filtre et l'affiche en colonne.
  employmentStatus        EmploymentStatus?     @map("employment_status")
  /// Volume horaire contractuel hebdomadaire (TEACHER uniquement).
  /// Indépendant des heures réellement enseignées (TeacherAssignment) et
  /// des disponibilités horaires (availability). Sert au KPI de couverture
  /// horaire de l'établissement (capacité totale dispo pour le solveur EDT).
  contractualHoursPerWeek Int?                  @map("contractual_hours_per_week")
  /// PDF du contrat — stocké dans MinIO via FileObject.
  contractFileId          String?               @unique @map("contract_file_id") @db.Uuid
  /// Photo de la personne — stockée dans MinIO via FileObject.
  photoFileId             String?               @unique @map("photo_file_id") @db.Uuid
  /// RH — uniquement TEACHER/STAFF
  experienceYears         Int?                  @map("experience_years")
  /// JSON : grille hebdomadaire de disponibilités { MON: [{from,to}], ... }
  availability            Json                  @default("{}") @map("availability")
  /// Données financières — uniquement TEACHER/STAFF
  rib                     String?
  bankName                String?               @map("bank_name")
  payrollMethod           PayrollPaymentMethod? @map("payroll_method")
  grossSalary             Decimal?              @map("gross_salary") @db.Decimal(12, 2)
  netSalary               Decimal?              @map("net_salary") @db.Decimal(12, 2)
  /// JSON : avantages [{label, amount}]
  benefits                Json                  @default("[]")
  /// JSON : retenues [{label, amount, date?}]
  deductions              Json                  @default("[]")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  deletedAt               DateTime?             @map("deleted_at")

  tenant                    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                      PersonRole?                 @relation(fields: [roleId], references: [id], onDelete: SetNull)
  serviceRef                Service?                    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  contractFile              FileObject?                 @relation("ContractFile", fields: [contractFileId], references: [id], onDelete: SetNull)
  photoFile                 FileObject?                 @relation("PhotoFile", fields: [photoFileId], references: [id], onDelete: SetNull)
  userPersons               UserPerson[]
  studentClasses            StudentClass[]
  mainOfClass               Class[]                     @relation("MainTeacher")
  delegateOfClass           Class[]                     @relation("ClassDelegate")
  attendanceRecords         AttendanceRecord[]          @relation("StudentAttendance")
  grades                    Grade[]                     @relation("StudentGrades")
  examSeats                 ExamSeat[]                  @relation("ExamSeats")
  examMarks                 ExamMark[]                  @relation("ExamMarks")
  examSupervisions          ExamSupervisor[]            @relation("ExamSupervisions")
  examGradings              ExamGrader[]                @relation("ExamGradings")
  subjectAppreciations      SubjectAppreciation[]       @relation("StudentSubjectAppreciations")
  councilEntries            CouncilEntry[]              @relation("StudentCouncil")
  carnetEntries             CarnetEntry[]               @relation("StudentCarnet")
  attendanceEvents          AttendanceEvent[]           @relation("StudentAttendanceEvents")
  installments              Installment[]               @relation("StudentInstallments")
  exceptionalFeeAssignments ExceptionalFeeAssignment[]  @relation("StudentExceptionalFees")
  paymentReminders          PaymentReminder[]           @relation("StudentPaymentReminders")
  /// Transport — lignes où la personne (STAFF) est chauffeur / accompagnatrice.
  linesAsDriver             TransportLine[]             @relation("LineDriver")
  linesAsAttendant          TransportLine[]             @relation("LineAttendant")
  transportAssignment       StudentTransport?           @relation("StudentTransport")
  transportAttendances      TransportAttendanceRecord[] @relation("StudentTransportAttendance")
  leaveRequests             LeaveRequest[]              @relation("PersonLeaveRequests")
  overtimeEntries           OvertimeEntry[]             @relation("PersonOvertime")
  payrollProfile            EmployeePayrollProfile?     @relation("PersonPayrollProfile")
  payslips                  Payslip[]                   @relation("PersonPayslips")
  booksSelling              BookCopy[]                  @relation("BookSeller")
  booksBuying               BookCopy[]                  @relation("BookBuyer")
  radiations                RadiationRequest[]          @relation("StudentRadiations")
  radiationRefunds          RadiationRefund[]           @relation("StudentRefunds")
  teacherAssignments        TeacherAssignment[]         @relation("TeacherAssignments")
  teacherSpecialties        TeacherSpecialty[]
  teacherCycles             TeacherCycle[]
  teacherPriorityClasses    TeacherPriorityClass[]
  diplomas                  Diploma[]
  staffAttendance           StaffAttendance[]           @relation("StaffAttendance")
  enrollments               Enrollment[]                @relation("StudentEnrollments")
  timetableEntries          TimetableEntry[]            @relation("TeacherTimetable")
  classGroupMemberships     ClassGroupMember[]          @relation("StudentClassGroups")
  classGroupsTaught         ClassGroup[]                @relation("ClassGroupTeacher")
  substitutionsAsTeacher    TimetableOverride[]         @relation("SubstituteTeacher")
  /// Liens de parenté où cette personne est l'enfant (FROM = student/PARENT-child)
  relationsAsChild          PersonRelation[]            @relation("ChildRelations")
  /// Liens où cette personne est le parent/tuteur (TO = parent/guardian)
  relationsAsParent         PersonRelation[]            @relation("ParentRelations")

  @@unique([tenantId, massarId])
  @@index([tenantId, type])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, roleId])
  @@index([tenantId, contractEndDate])
  @@index([tenantId, service])
  @@index([tenantId, serviceId])
  @@map("persons")
}

/// Spécialités d'un enseignant : matières qu'il est capable d'enseigner
/// (vs TeacherAssignment qui est ce qu'il enseigne effectivement cette année).
model TeacherSpecialty {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Person  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([tenantId, teacherId])
  @@index([tenantId, subjectId])
  @@map("teacher_specialties")
}

/// Cycles enseignés par un enseignant (Primaire, Collège, Lycée…).
model TeacherCycle {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  cycleId   String   @map("cycle_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Person @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  cycle   Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([teacherId, cycleId])
  @@index([tenantId, teacherId])
  @@map("teacher_cycles")
}

/// Classes prioritaires d'un enseignant : classes sur lesquelles il doit être
/// servi en priorité lors de l'auto-affectation / génération de l'EDT.
/// Préférence d'allocation (≠ affectation ferme via TeacherAssignment).
model TeacherPriorityClass {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Person @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
  @@index([tenantId, teacherId])
  @@index([tenantId, classId])
  @@map("teacher_priority_classes")
}

/// Diplômes / certifications d'une personne (TEACHER ou STAFF).
model Diploma {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  personId    String   @map("person_id") @db.Uuid
  title       String // ex : "Licence en mathématiques"
  institution String? // ex : "Université Hassan II"
  year        Int? // ex : 2018
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, personId])
  @@map("diplomas")
}

/// Affectation pédagogique : un enseignant enseigne une matière à une classe
/// donnée pour une année scolaire. Sert à filtrer la saisie de notes et de
/// base à l'emploi du temps.
model TeacherAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  hoursPerWeek   Float?   @map("hours_per_week")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher      Person       @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId, academicYearId])
  @@index([tenantId, teacherId])
  @@index([tenantId, classId, academicYearId])
  @@index([tenantId, subjectId])
  @@map("teacher_assignments")
}

/// Catégorie paramétrable pour les enseignants ou le personnel.
/// Bilingue FR/AR — l'affichage choisit selon la locale active.
model PersonRole {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  appliesTo PersonType @map("applies_to") // TEACHER ou STAFF
  code      String // identifiant stable (MAIN_TEACHER, BURSAR, ...)
  labelFr   String     @map("label_fr")
  labelAr   String     @map("label_ar")
  /// Service / département auquel ce type est rattaché. Pour les types
  /// TEACHER, c'est toujours le service « Enseignants ».
  serviceId String?    @map("service_id") @db.Uuid
  order     Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  persons Person[]

  @@unique([tenantId, code])
  @@index([tenantId, appliesTo, order])
  @@index([tenantId, serviceId])
  @@map("person_roles")
}

/// Service / département paramétrable de rattachement du personnel.
/// Remplace l'enum figé StaffService par une nomenclature éditable par tenant
/// (CRUD comme PersonRole). Bilingue FR/AR.
model Service {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String // identifiant stable (DIRECTION, ENSEIGNANTS, ...)
  labelFr   String   @map("label_fr")
  labelAr   String   @map("label_ar")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personRoles PersonRole[]
  persons     Person[]

  @@unique([tenantId, code])
  @@index([tenantId, order])
  @@map("services")
}

/// Lien explicite parent ↔ enfant (Père, Mère, Tuteur légal, Tuteur).
/// La fratrie est *déduite* via parents partagés (pas stockée).
model PersonRelation {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  /// Élève
  childId   String       @map("child_id") @db.Uuid
  /// Parent ou tuteur
  parentId  String       @map("parent_id") @db.Uuid
  type      RelationType
  createdAt DateTime     @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  child  Person @relation("ChildRelations", fields: [childId], references: [id], onDelete: Cascade)
  parent Person @relation("ParentRelations", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([childId, parentId])
  @@index([tenantId, childId])
  @@index([tenantId, parentId])
  @@map("person_relations")
}

/// Lien compte ↔ identité (un user peut représenter plusieurs persons,
/// ex. parent rattaché à plusieurs enfants).
model UserPerson {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  personId     String   @map("person_id") @db.Uuid
  relationship String? // self, father, mother, guardian, ...
  createdAt    DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([userId, personId])
  @@index([tenantId])
  @@map("user_persons")
}

/// Jeton de réinitialisation de mot de passe (flux « mot de passe oublié »).
/// Émis pour les comptes du portail parent. On ne stocke que le SHA-256 du
/// jeton (`tokenHash`) — le jeton en clair n'existe que dans le lien e-mail.
/// Usage unique (`usedAt`) + expiration courte (`expiresAt`).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── RBAC ──────────────────────────────────────────────────

